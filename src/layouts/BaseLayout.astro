---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'ModelPath Studio is an independent software studio creating elegant mobile applications and intelligent digital experiences.',
  canonicalUrl: customCanonical,
  ogType = 'website',
  ogImage = '/favicon.svg',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://modelpath.app').replace(/\/$/, '');
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/')) {
  pathname += '/';
}
const canonical = customCanonical || `${siteOrigin}${pathname}`;

const fullTitle = title.includes('ModelPath Studio') ? title : `${title} | ModelPath Studio`;
const fullOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const baseSchemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'ModelPath Studio',
    url: siteOrigin,
    logo: `${siteOrigin}/favicon.svg`,
    description: 'Independent software studio creating thoughtful mobile applications and intelligent digital tools.',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'General Inquiry',
        email: 'hello@modelpath.app',
        url: `${siteOrigin}/contact/`,
      },
      {
        '@type': 'ContactPoint',
        contactType: 'Technical Support',
        email: 'support@modelpath.app',
        url: `${siteOrigin}/contact/`,
      },
      {
        '@type': 'ContactPoint',
        contactType: 'Privacy Inquiries',
        email: 'privacy@modelpath.app',
        url: `${siteOrigin}/privacy/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: siteOrigin,
    name: 'ModelPath Studio',
    description: 'Thoughtful Software. Beautifully Built.',
    publisher: {
      '@id': `${siteOrigin}/#organization`,
    },
  },
];

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...baseSchemas, ...pageSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted Privacy-Preserving Fonts (Zero runtime external requests) -->
    <link rel="preload" href="/fonts/plus-jakarta-sans-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="ModelPath Studio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Structured Data (JSON-LD) -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- JS detection for progressive enhancement -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="site-wrapper">
      <SiteHeader />
      <main id="main-content" class="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <!-- Supporting Motion: Scroll-triggered entry reveals -->
    <script>
      function setupScrollReveals() {
        if (!('IntersectionObserver' in window)) return;
        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)');
        if (motionQuery.matches) {
          reveals.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
        );

        reveals.forEach((el) => observer.observe(el));
      }

      setupScrollReveals();
      document.addEventListener('astro:after-swap', setupScrollReveals);
    </script>
  </body>
</html>

<style>
  .site-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--c-midnight);
    position: relative;
  }

  .main-content {
    flex: 1;
    width: 100%;
  }
</style>
