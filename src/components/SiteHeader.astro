---
interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

const isLinkActive = (path: string) => {
  if (path === '/' && activePath === '/') return true;
  if (path !== '/' && activePath.startsWith(path)) return true;
  return false;
};
---

<header class="header-outer">
  <!-- Desktop & Tablet Floating Header Pill -->
  <div class="nav-desktop">
    <a href="/" class="brand-container" aria-label="ModelPath Studio Homepage">
      <div class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
        </svg>
      </div>
      <span class="brand-name">ModelPath Studio</span>
    </a>

    <nav class="desktop-nav-links" aria-label="Primary Navigation">
      <ul class="nav-list">
        <li>
          <a href="/" class={`nav-link ${isLinkActive('/') ? 'active' : ''}`}>
            Home
          </a>
        </li>
        <li>
          <a href="/apps/" class={`nav-link ${isLinkActive('/apps') ? 'active' : ''}`}>
            Apps
          </a>
        </li>
        <li>
          <a href="/about/" class={`nav-link ${isLinkActive('/about') ? 'active' : ''}`}>
            About
          </a>
        </li>
        <li>
          <a href="/contact/" class={`nav-link ${isLinkActive('/contact') ? 'active' : ''}`}>
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <div class="nav-cta-wrapper">
      <a href="/apps/" class="nav-cta-btn">
        Explore Apps &rarr;
      </a>
    </div>
  </div>

  <!-- Mobile Header Bar (< 860px) -->
  <div class="nav-mobile">
    <a href="/" class="brand-container" aria-label="ModelPath Studio Homepage">
      <div class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
        </svg>
      </div>
      <span class="brand-name">ModelPath</span>
    </a>

    <button
      id="mobile-nav-toggle"
      class="hamburger-btn"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
      aria-label="Toggle navigation menu"
    >
      <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" class="line-top" />
        <line x1="3" y1="12" x2="21" y2="12" class="line-mid" />
        <line x1="3" y1="18" x2="21" y2="18" class="line-bot" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <nav id="mobile-nav-menu" class="mobile-menu" aria-label="Mobile Navigation" hidden>
    <ul class="mobile-menu-list">
      <li>
        <a href="/" class={`mobile-menu-link ${isLinkActive('/') ? 'active' : ''}`}>
          Home
        </a>
      </li>
      <li>
        <a href="/apps/" class={`mobile-menu-link ${isLinkActive('/apps') ? 'active' : ''}`}>
          Apps
        </a>
      </li>
      <li>
        <a href="/about/" class={`mobile-menu-link ${isLinkActive('/about') ? 'active' : ''}`}>
          About
        </a>
      </li>
      <li>
        <a href="/contact/" class={`mobile-menu-link ${isLinkActive('/contact') ? 'active' : ''}`}>
          Contact
        </a>
      </li>
    </ul>
    <div class="mobile-menu-cta">
      <a href="/apps/" class="mobile-cta-btn">Explore All Apps &rarr;</a>
    </div>
  </nav>
</header>

<script>
  function setupMobileNav() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      toggle.setAttribute('aria-expanded', String(nextExpanded));
      menu.hidden = !nextExpanded;
      if (!nextExpanded) {
        toggle.focus();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        toggle.focus();
      }
    });
  }

  setupMobileNav();
  document.addEventListener('astro:after-swap', setupMobileNav);
</script>

<style>
  .header-outer {
    position: sticky;
    top: 20px;
    z-index: 100;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    margin-bottom: -84px;
    pointer-events: none;
  }

  /* Desktop Floating Nav Pill */
  .nav-desktop {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    height: 64px;
    background: rgba(17, 26, 51, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--c-border-dark);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-nav);
    padding: 0 24px;
  }

  .brand-container {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, var(--c-cobalt), var(--c-violet));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .brand-mark svg {
    width: 20px;
    height: 20px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .desktop-nav-links {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--c-text-light-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: #FFFFFF;
  }

  .nav-link.active {
    color: #FFFFFF;
    background: rgba(79, 107, 255, 0.18);
    border: 1px solid rgba(79, 107, 255, 0.35);
  }

  .nav-cta-btn {
    background: var(--c-cobalt);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(79, 107, 255, 0.35);
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-cta-btn:hover {
    background: var(--c-cobalt-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(79, 107, 255, 0.45);
  }

  /* Mobile Nav Bar */
  .nav-mobile {
    display: none;
    pointer-events: auto;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 54px;
    background: rgba(17, 26, 51, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--c-border-dark);
    border-radius: var(--radius-pill);
    padding: 0 16px;
    box-shadow: var(--shadow-nav);
  }

  .hamburger-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
  }

  .hamburger-icon {
    width: 20px;
    height: 20px;
  }

  /* Mobile Dropdown Menu */
  .mobile-menu {
    pointer-events: auto;
    margin-top: 10px;
    background: rgba(17, 26, 51, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--c-border-dark);
    border-radius: var(--radius-card-mobile);
    padding: 18px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
  }

  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-menu-link {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--c-text-light-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link.active {
    color: #FFFFFF;
    background: rgba(79, 107, 255, 0.2);
  }

  .mobile-menu-cta {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(79, 107, 255, 0.2);
  }

  .mobile-cta-btn {
    display: block;
    text-align: center;
    background: var(--c-cobalt);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 10px;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 860px) {
    .header-outer {
      top: 14px;
      padding: 0 16px;
      margin-bottom: -68px;
    }
    .nav-desktop {
      display: none;
    }
    .nav-mobile {
      display: flex;
    }
  }
</style>
