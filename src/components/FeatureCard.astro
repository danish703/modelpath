---
interface Props {
  title: string;
  description: string;
  iconType?: 'pen' | 'document' | 'privacy' | 'performance' | string;
  status?: 'available' | 'planned' | 'verification-pending';
}

const { title, description, iconType = 'document', status } = Astro.props;
---

<div class="feature-card">
  <div class="feature-header">
    <div class="feature-icon-well">
      {iconType === 'pen' && (
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
        </svg>
      )}
      {iconType === 'document' && (
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
        </svg>
      )}
      {iconType === 'privacy' && (
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      )}
      {iconType === 'performance' && (
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
      )}
      {!['pen', 'document', 'privacy', 'performance'].includes(iconType) && (
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 14 14" />
        </svg>
      )}
    </div>
    <h3 class="feature-title">
      <span>{title}</span>
      {status === 'planned' && <span class="feature-status-chip chip-planned">Planned</span>}
      {status === 'verification-pending' && <span class="feature-status-chip chip-pending">Verification Pending</span>}
    </h3>
  </div>
  <p class="feature-desc">{description}</p>
</div>

<style>
  .feature-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .feature-icon-well {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    box-shadow: var(--shadow-inset-box);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-icon-well svg {
    width: 22px;
    height: 22px;
    stroke: var(--accent-blue);
  }

  .feature-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.3;
    margin: 0;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .feature-status-chip {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--bg-inset);
    color: var(--text-muted);
    box-shadow: var(--shadow-inset-box);
    border: 1px solid rgba(169, 180, 196, 0.35);
  }

  .feature-status-chip.chip-planned {
    color: var(--text-muted);
  }

  .feature-status-chip.chip-pending {
    color: #92400e;
    background: rgba(245, 158, 11, 0.08);
    border-color: rgba(217, 119, 6, 0.28);
  }

  .feature-desc {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 600px) {
    .feature-card {
      padding: 18px 16px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
    }

    .feature-icon-well {
      width: 38px;
      height: 38px;
    }

    .feature-icon-well svg {
      width: 20px;
      height: 20px;
    }

    .feature-title {
      font-size: 1.05rem;
    }

    .feature-desc {
      font-size: 0.875rem;
    }
  }
</style>
