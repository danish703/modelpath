---
interface Props {
  title: string;
  description: string;
  iconType?: 'pen' | 'document' | 'privacy' | 'performance' | string;
  status?: 'available' | 'planned' | 'verification-pending';
}

const { title, description, iconType = 'document', status } = Astro.props;
---

<div class="cap-card" data-reveal>
  <div class="cap-card-header">
    <div class="cap-icon-box">
      {iconType === 'pen' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
        </svg>
      )}
      {iconType === 'document' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
        </svg>
      )}
      {iconType === 'privacy' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      )}
      {iconType === 'performance' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
      )}
      {!['pen', 'document', 'privacy', 'performance'].includes(iconType) && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 14 14" />
        </svg>
      )}
    </div>

    {status === 'planned' && <span class="cap-status-pill core">Planned Feature</span>}
    {status === 'verification-pending' && <span class="cap-status-pill verification">Under Verification</span>}
    {status === 'available' && <span class="cap-status-pill core">Core Feature</span>}
  </div>

  <div>
    <h3 class="cap-title">{title}</h3>
    <p class="cap-desc">{description}</p>
  </div>
</div>

<style>
  .cap-card {
    background: #FFFFFF;
    padding: 30px;
    border-radius: 16px;
    border: 1px solid rgba(203, 213, 225, 0.7);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cap-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .cap-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cap-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(79, 107, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-cobalt);
    flex-shrink: 0;
  }

  .cap-icon-box svg {
    width: 22px;
    height: 22px;
  }

  .cap-status-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .cap-status-pill.core {
    background: #EFF6FF;
    color: #1E40AF;
    border: 1px solid #BFDBFE;
  }

  .cap-status-pill.verification {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
  }

  .cap-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c-text-dark);
    margin-bottom: 6px;
  }

  .cap-desc {
    font-size: 0.94rem;
    color: var(--c-text-dark-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 600px) {
    .cap-card {
      padding: 22px 20px;
      gap: 16px;
    }
    .cap-title {
      font-size: 1.2rem;
    }
    .cap-desc {
      font-size: 1rem;
      line-height: 1.6;
    }
    .cap-status-pill {
      font-size: 0.78rem;
      padding: 4px 10px;
    }
  }
</style>
