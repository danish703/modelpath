---
import StatusBadge from './StatusBadge.astro';
import AppIcon from './AppIcon.astro';
import { formatPlatforms, type ImageAsset } from '../lib/appMedia';

interface AppItem {
  slug: string;
  name: string;
  category: string;
  tagline?: string;
  description?: string;
  status: string;
  availablePlatforms?: string[];
  plannedPlatforms?: string[];
  icon?: ImageAsset | null;
}

interface Props {
  currentSlug: string;
  apps: AppItem[];
}

const { currentSlug, apps } = Astro.props;
const relatedApps = apps.filter((app) => app.slug !== currentSlug).slice(0, 3);
---

{relatedApps.length > 0 && (
  <section class="related-section">
    <div class="section-meta">
      <span class="section-label">More From ModelPath</span>
      <h2 class="section-title">Related Applications</h2>
    </div>

    <div class="related-grid">
      {relatedApps.map((app) => (
        <a href={`/apps/${app.slug}/`} class="related-card" data-reveal>
          <div class="related-card-top">
            <AppIcon slug={app.slug} name={app.name} icon={app.icon ?? null} size="sm" class="related-icon" />
            {app.status !== 'published' && <StatusBadge status={app.status} size="sm" />}
          </div>

          <div class="related-category">{app.category}</div>
          <h3 class="related-title">{app.name}</h3>
          <p class="related-desc">{app.tagline || app.description}</p>

          <div class="related-footer">
            <span class="platform-hint">
              {app.availablePlatforms && app.availablePlatforms.length > 0
                ? `Available on ${formatPlatforms(app.availablePlatforms)}`
                : app.plannedPlatforms && app.plannedPlatforms.length > 0
                ? `Target: ${formatPlatforms(app.plannedPlatforms)}`
                : 'Platforms: TBD'}
            </span>
            <span class="explore-hint">Explore <span class="explore-arrow" aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-section {
    width: 100%;
    margin-top: 56px;
    margin-bottom: 24px;
  }

  .section-meta {
    margin-bottom: 24px;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 4px;
  }

  .section-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.03);
    padding: 24px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    border-color: rgba(79, 107, 255, 0.4);
  }

  .related-card:active {
    transform: translateY(-1px);
  }

  .explore-arrow {
    display: inline-block;
    transition: transform var(--transition-normal, 0.2s ease);
  }

  .related-card:hover .explore-arrow {
    transform: translateX(3px);
  }

  .related-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .related-category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-cobalt, #4F6BFF);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .related-title {
    font-family: var(--font-display, inherit);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .related-desc {
    font-size: 0.88rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.55;
    flex: 1;
    margin: 0;
  }

  .related-footer {
    padding-top: 14px;
    border-top: 1px solid rgba(203, 213, 225, 0.5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--c-cobalt, #4F6BFF);
    font-weight: 600;
  }

  .platform-hint {
    color: var(--c-text-dark-muted, #64748B);
    font-weight: 500;
    font-size: 0.75rem;
  }

  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .related-card {
      padding: 18px 16px;
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card:hover,
    .related-card:active,
    .related-card:hover .explore-arrow {
      transform: none;
    }
  }
</style>
