---
import StatusBadge from './StatusBadge.astro';

interface AppItem {
  slug: string;
  name: string;
  category: string;
  tagline?: string;
  description?: string;
  status: string;
  availablePlatforms?: string[];
  plannedPlatforms?: string[];
}

interface Props {
  currentSlug: string;
  apps: AppItem[];
}

const { currentSlug, apps } = Astro.props;
const relatedApps = apps.filter((app) => app.slug !== currentSlug).slice(0, 3);
---

{relatedApps.length > 0 && (
  <section class="related-section">
    <div class="section-meta">
      <span class="section-label">More From ModelPath</span>
      <h2 class="section-title">Related Applications</h2>
    </div>

    <div class="related-grid">
      {relatedApps.map((app) => (
        <a href={`/apps/${app.slug}/`} class="related-card">
          <div class="related-card-top">
            <div class="related-icon-well">
              {app.slug === 'signmint' && (
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
              )}
              {app.slug === 'ehub' && (
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
              )}
              {app.slug === 'pylab' && (
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
              )}
              {app.slug === 'modelpath-ml' && (
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="3" />
                  <circle cx="19" cy="6" r="2" />
                  <circle cx="5" cy="6" r="2" />
                  <circle cx="19" cy="18" r="2" />
                  <circle cx="5" cy="18" r="2" />
                </svg>
              )}
              {!['signmint', 'ehub', 'pylab', 'modelpath-ml'].includes(app.slug) && (
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                </svg>
              )}
            </div>
            <StatusBadge status={app.status} size="sm" />
          </div>

          <div class="related-category">{app.category}</div>
          <h3 class="related-title">{app.name}</h3>
          <p class="related-desc">{app.tagline || app.description}</p>

          <div class="related-footer">
            <span class="platform-hint">
              {app.availablePlatforms && app.availablePlatforms.length > 0
                ? `Available on ${app.availablePlatforms.join(', ')}`
                : app.plannedPlatforms && app.plannedPlatforms.length > 0
                ? `Target: ${app.plannedPlatforms.join(' & ')}`
                : 'Platforms: TBD'}
            </span>
            <span class="explore-hint">Explore &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-section {
    width: 100%;
    margin-top: 48px;
    margin-bottom: 24px;
  }

  .section-meta {
    margin-bottom: 24px;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 4px;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: -8px -8px 20px #FFFFFF, 8px 8px 20px rgba(169, 180, 196, 0.32);
  }

  .related-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .related-icon-well {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-inset-box);
    background: var(--bg-raised);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .related-icon-well svg {
    width: 22px;
    height: 22px;
    stroke: var(--accent-blue);
  }

  .related-category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
  }

  .related-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.5;
    flex: 1;
    margin: 0;
  }

  .related-footer {
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .platform-hint {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.75rem;
  }

  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .related-card {
      padding: 18px 16px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
    }
  }
</style>
