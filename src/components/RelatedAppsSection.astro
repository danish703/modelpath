---
import StatusBadge from './StatusBadge.astro';
import AppIcon from './AppIcon.astro';
import { formatPlatforms, type ImageAsset } from '../lib/appMedia';

interface AppItem {
  slug: string;
  name: string;
  category: string;
  tagline?: string;
  description?: string;
  status: string;
  availablePlatforms?: string[];
  plannedPlatforms?: string[];
  icon?: ImageAsset | null;
}

interface Props {
  currentSlug: string;
  apps: AppItem[];
}

const { currentSlug, apps } = Astro.props;
const relatedApps = apps.filter((app) => app.slug !== currentSlug).slice(0, 3);
---

{relatedApps.length > 0 && (
  <section class="related-section">
    <div class="section-meta">
      <span class="section-label">More From ModelPath</span>
      <h2 class="section-title">Related Applications</h2>
    </div>

    <div class="related-grid">
      {relatedApps.map((app) => (
        <a href={`/apps/${app.slug}/`} class="related-card" data-reveal>
          <div class="related-card-top">
            <AppIcon slug={app.slug} name={app.name} icon={app.icon ?? null} size="sm" class="related-icon" />
            <StatusBadge status={app.status} size="sm" />
          </div>

          <div class="related-category">{app.category}</div>
          <h3 class="related-title">{app.name}</h3>
          <p class="related-desc">{app.tagline || app.description}</p>

          <div class="related-footer">
            <span class="platform-hint">
              {app.availablePlatforms && app.availablePlatforms.length > 0
                ? `Available on ${formatPlatforms(app.availablePlatforms)}`
                : app.plannedPlatforms && app.plannedPlatforms.length > 0
                ? `Target: ${formatPlatforms(app.plannedPlatforms)}`
                : 'Platforms: TBD'}
            </span>
            <span class="explore-hint">Explore <span class="explore-arrow" aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-section {
    width: 100%;
    margin-top: 48px;
    margin-bottom: 24px;
  }

  .section-meta {
    margin-bottom: 24px;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 4px;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: -8px -8px 22px #FFFFFF, 10px 12px 26px rgba(169, 180, 196, 0.34);
  }

  .related-card:active {
    transform: translateY(-1px) scale(0.995);
  }

  .related-card:hover :global(.related-icon) {
    transform: translateY(-2px);
  }

  .explore-arrow {
    display: inline-block;
    transition: transform var(--transition-normal);
  }

  .related-card:hover .explore-arrow {
    transform: translateX(2px);
  }

  .related-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .related-category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
  }

  .related-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.5;
    flex: 1;
    margin: 0;
  }

  .related-footer {
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .platform-hint {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.75rem;
  }

  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .related-card {
      padding: 18px 16px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card:hover,
    .related-card:active,
    .related-card:hover :global(.related-icon),
    .related-card:hover .explore-arrow {
      transform: none;
    }
  }
</style>
