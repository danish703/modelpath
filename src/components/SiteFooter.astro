---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`footer-dark ${className}`}>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-brand-title">
          <div class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          </div>
          <span>ModelPath Studio</span>
        </div>
        <p class="footer-desc">
          Independent software studio building thoughtful, privacy-first mobile and desktop utilities with native craft.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <ul class="footer-links-wrap">
          <li><a href="/">Home</a></li>
          <li><a href="/apps/">Apps</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/app-ads.txt">app-ads.txt</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} ModelPath Studio. All rights reserved. Independent Software Studio.
      </p>
      <span class="footer-tag">Midnight Aurora &bull; Static Delivery</span>
    </div>
  </div>
</footer>

<style>
  .footer-dark {
    width: 100%;
    background: var(--c-midnight);
    border-top: 1px solid rgba(79, 107, 255, 0.2);
    padding: 64px 0 36px 0;
    color: var(--c-text-light);
    margin-top: auto;
  }

  .footer-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(79, 107, 255, 0.14);
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 440px;
  }

  .footer-brand-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 12px;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--c-cobalt), var(--c-violet));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
  }

  .brand-mark svg {
    width: 16px;
    height: 16px;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--c-text-light-muted);
    line-height: 1.6;
    margin: 0;
  }

  .footer-links-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links-wrap a {
    color: var(--c-text-light-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links-wrap a:hover {
    color: #FFFFFF;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    font-size: 0.84rem;
    color: #64748B;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-copy {
    margin: 0;
  }

  .footer-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #64748B;
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 0 20px;
    }
    .footer-top {
      flex-direction: column;
      gap: 28px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
