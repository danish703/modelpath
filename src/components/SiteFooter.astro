---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`footer-container ${className}`}>
  <nav class="footer-nav" aria-label="Footer Navigation">
    <ul class="footer-links-wrap">
      <li><a href="/">Home</a></li>
      <li><a href="/apps/">Apps</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/app-ads.txt">app-ads.txt</a></li>
    </ul>
  </nav>
  <p class="footer-copy">
    &copy; {currentYear} ModelPath Studio. All rights reserved. Independent Software Studio.
  </p>
</footer>

<style>
  .footer-container {
    width: 100%;
    max-width: 1120px;
    margin: 48px auto 0;
    padding: 36px 16px 24px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .footer-links-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links-wrap a {
    color: var(--text-body);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links-wrap a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .footer-copy {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 600px) {
    .footer-container {
      margin-top: 36px;
      padding-top: 24px;
      gap: 14px;
    }

    .footer-links-wrap {
      gap: 10px 16px;
    }

    .footer-links-wrap a {
      font-size: 0.8125rem;
    }

    .footer-copy {
      font-size: 0.75rem;
    }
  }
</style>
