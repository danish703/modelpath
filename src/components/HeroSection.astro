---
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';

interface Props {
  subheading?: string;
}

const {
  subheading = 'An independent software studio creating elegant mobile applications and intelligent digital experiences with a focus on craft and privacy.',
} = Astro.props;

/* Static constellation fallback (no-JS / pre-hydration). Deterministic so the
   markup is stable between builds. */
const VB_W = 1200;
const VB_H = 560;
let seed = 20261013;
const rnd = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const staticNodes = Array.from({ length: 42 }, () => ({
  x: Math.round(rnd() * VB_W),
  y: Math.round(rnd() * VB_H),
  r: +(1.2 + rnd() * 1.4).toFixed(2),
  cyan: rnd() < 0.45,
}));
const staticLinks: Array<{ x1: number; y1: number; x2: number; y2: number; o: number }> = [];
for (let i = 0; i < staticNodes.length; i++) {
  for (let j = i + 1; j < staticNodes.length; j++) {
    const a = staticNodes[i];
    const b = staticNodes[j];
    const d = Math.hypot(a.x - b.x, a.y - b.y);
    if (d < 140) staticLinks.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, o: +((1 - d / 140) * 0.28).toFixed(3) });
  }
}
---

<section class="hero-wrapper">
  <!-- Subtle Constellation background on Midnight Navy canvas -->
  <div class="hero-constellation" data-constellation aria-hidden="true">
    <svg
      class="constellation-static"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      {staticLinks.map((l) => (
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="rgb(79,107,255)" stroke-opacity={l.o} stroke-width="0.8" />
      ))}
      {staticNodes.map((n) => (
        <circle cx={n.x} cy={n.y} r={n.r} fill={n.cyan ? 'rgb(115,221,230)' : 'rgb(139,92,246)'} fill-opacity={n.cyan ? 0.75 : 0.60} />
      ))}
    </svg>
    <canvas class="constellation-canvas" data-constellation-canvas></canvas>
  </div>

  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>Independent Digital Software Studio</span>
      </div>

      <h1 class="hero-headline">
        Thoughtful Software.<br />
        <span class="gradient-text">Beautifully Built.</span>
      </h1>

      <p class="hero-subheading">{subheading}</p>

      <div class="hero-cta-group">
        <PrimaryButton href="/apps/">
          <span>Explore Applications</span>
          <span aria-hidden="true">&rarr;</span>
        </PrimaryButton>
        <SecondaryButton href="/about/">
          <span>About ModelPath</span>
        </SecondaryButton>
      </div>

      <!-- Factual Portfolio Metrics Bar -->
      <div class="hero-metrics-bar">
        <span class="metric-pill">4 Active Applications</span>
        <span class="metric-pill">Independent Studio</span>
        <span class="metric-pill">Static Fast Delivery</span>
        <span class="metric-pill">Android &amp; iOS Focus</span>
      </div>
    </div>

    <!-- Subordinate Hero Miniature Showcase -->
    <aside class="hero-showcase" aria-label="Application Ecosystem Overview">
      <div class="showcase-header">
        <span class="showcase-title">Studio Ecosystem</span>
        <span class="showcase-tag">4 Projects Active</span>
      </div>

      <div class="showcase-grid">
        <!-- SignMint -->
        <a href="/apps/signmint/" class="mini-tile">
          <div class="mini-tile-icon" style="color:var(--c-cobalt);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
          </div>
          <div class="mini-tile-info">
            <span class="mini-tile-name">SignMint</span>
            <span class="mini-tile-meta">Productivity &bull; Coming Soon</span>
          </div>
        </a>

        <!-- Ehub -->
        <a href="/apps/ehub/" class="mini-tile">
          <div class="mini-tile-icon" style="color:var(--c-violet);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
          </div>
          <div class="mini-tile-info">
            <span class="mini-tile-name">Ehub</span>
            <span class="mini-tile-meta">Reading &bull; In Dev</span>
          </div>
        </a>

        <!-- PyLab -->
        <a href="/apps/pylab/" class="mini-tile">
          <div class="mini-tile-icon" style="color:var(--c-cyan);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 17 10 11 4 5" />
              <line x1="12" y1="19" x2="20" y2="19" />
            </svg>
          </div>
          <div class="mini-tile-info">
            <span class="mini-tile-name">PyLab</span>
            <span class="mini-tile-meta">Education &bull; In Dev</span>
          </div>
        </a>

        <!-- ModelPath ML -->
        <a href="/apps/modelpath-ml/" class="mini-tile">
          <div class="mini-tile-icon" style="color:var(--c-cobalt);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3" />
              <circle cx="19" cy="6" r="2" />
              <circle cx="5" cy="6" r="2" />
              <circle cx="19" cy="18" r="2" />
              <circle cx="5" cy="18" r="2" />
            </svg>
          </div>
          <div class="mini-tile-info">
            <span class="mini-tile-name">ModelPath ML</span>
            <span class="mini-tile-meta">Machine Learning &bull; Research</span>
          </div>
        </a>
      </div>
    </aside>
  </div>
</section>

<script>
  import { initConstellation } from '../scripts/constellation';

  function setupConstellation() {
    const hero = document.querySelector<HTMLElement>('[data-constellation]');
    if (!hero) return;
    initConstellation(hero);
  }

  setupConstellation();
  document.addEventListener('astro:after-swap', setupConstellation);
</script>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    background: radial-gradient(circle at 60% 25%, rgba(79, 107, 255, 0.18) 0%, rgba(139, 92, 246, 0.09) 45%, transparent 75%), var(--c-midnight);
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
    overflow: hidden;
    padding-top: 140px;
    padding-bottom: 80px;
  }

  .hero-constellation {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .constellation-static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .constellation-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(html.js) .constellation-static {
    display: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(23, 36, 65, 0.85);
    border: 1px solid rgba(79, 107, 255, 0.3);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-cyan);
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-cyan);
    box-shadow: 0 0 8px var(--c-cyan);
    flex-shrink: 0;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    margin-bottom: 20px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #FFFFFF 30%, var(--c-cyan) 80%, var(--c-violet) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subheading {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: var(--c-text-light-muted);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .hero-metrics-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .metric-pill {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--c-text-light-muted);
    background: rgba(17, 26, 51, 0.8);
    border: 1px solid rgba(79, 107, 255, 0.22);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  /* Subordinate Mini Showcase */
  .hero-showcase {
    background: rgba(17, 26, 51, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-card);
    padding: 28px;
    border: 1px solid rgba(79, 107, 255, 0.28);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
  }

  .showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
  }

  .showcase-title {
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .showcase-tag {
    font-size: 0.75rem;
    color: var(--c-cyan);
    background: rgba(115, 221, 230, 0.12);
    border: 1px solid rgba(115, 221, 230, 0.3);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .mini-tile {
    background: #141E38;
    border: 1px solid rgba(79, 107, 255, 0.22);
    border-radius: var(--radius-inner);
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .mini-tile:hover {
    border-color: var(--c-cobalt);
    background: #192546;
    transform: translateY(-2px);
  }

  .mini-tile-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mini-tile-icon svg {
    width: 22px;
    height: 22px;
  }

  .mini-tile-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mini-tile-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-tile-meta {
    font-size: 0.74rem;
    color: var(--c-text-light-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 960px) {
    .hero-wrapper {
      padding-top: 110px;
      padding-bottom: 60px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .hero-wrapper {
      padding-top: 100px;
      padding-bottom: 52px;
    }
    .hero-inner {
      padding: 0 20px;
    }
    .hero-badge {
      font-size: 0.78rem;
      padding: 6px 14px;
      margin-bottom: 18px;
    }
    .hero-headline {
      font-size: clamp(2rem, 7.5vw, 2.5rem);
      margin-bottom: 16px;
    }
    .hero-subheading {
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      gap: 12px;
      margin-bottom: 26px;
    }
    .hero-cta-group :global(a) {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }
    .hero-metrics-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      width: 100%;
    }
    .metric-pill {
      text-align: center;
      font-size: 0.78rem;
      padding: 8px 10px;
      white-space: normal;
    }
    .hero-showcase {
      padding: 22px 18px;
    }
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .mini-tile {
      padding: 12px 14px;
      min-height: 56px;
    }
    .mini-tile-name {
      font-size: 1rem;
    }
    .mini-tile-meta {
      font-size: 0.8rem;
    }
  }
</style>
