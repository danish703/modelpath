---
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';

interface Props {
  headline?: string;
  subheading?: string;
}

const {
  headline = 'Thoughtful Software. Beautifully Built.',
  subheading = 'An independent software studio creating elegant mobile applications and intelligent digital experiences.',
} = Astro.props;

/* Static constellation fallback (no-JS / pre-hydration). Deterministic so the
   markup is stable between builds. */
const VB_W = 1200;
const VB_H = 560;
let seed = 20261013;
const rnd = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const staticNodes = Array.from({ length: 46 }, () => ({
  x: Math.round(rnd() * VB_W),
  y: Math.round(rnd() * VB_H),
  r: +(0.9 + rnd() * 1.1).toFixed(2),
  blue: rnd() < 0.38,
}));
const staticLinks: Array<{ x1: number; y1: number; x2: number; y2: number; o: number }> = [];
for (let i = 0; i < staticNodes.length; i++) {
  for (let j = i + 1; j < staticNodes.length; j++) {
    const a = staticNodes[i];
    const b = staticNodes[j];
    const d = Math.hypot(a.x - b.x, a.y - b.y);
    if (d < 150) staticLinks.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, o: +((1 - d / 150) * 0.16).toFixed(3) });
  }
}
---

<section class="hero-container">
  <!-- Subtle Constellation background (decorative, restricted to the hero) -->
  <div class="hero-constellation" data-constellation aria-hidden="true">
    <svg
      class="constellation-static"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      {staticLinks.map((l) => (
        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="rgb(100,116,139)" stroke-opacity={l.o} stroke-width="0.7" />
      ))}
      {staticNodes.map((n) => (
        <circle cx={n.x} cy={n.y} r={n.r} fill={n.blue ? 'rgb(69,103,232)' : 'rgb(100,116,139)'} fill-opacity={n.blue ? 0.5 : 0.36} />
      ))}
    </svg>
    <canvas class="constellation-canvas" data-constellation-canvas></canvas>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-dot" aria-hidden="true"></span>
      <span>Independent Software Studio</span>
    </div>

    <h1 class="hero-headline">{headline}</h1>

    <p class="hero-subheading">{subheading}</p>

    <div class="hero-cta-group">
      <PrimaryButton href="/apps/">
        <span>Explore Our Apps</span>
        <span aria-hidden="true">&rarr;</span>
      </PrimaryButton>
      <SecondaryButton href="/about/">
        About ModelPath
      </SecondaryButton>
    </div>
  </div>

  <!-- Subordinate Hero Miniature Showcase -->
  <aside class="hero-showcase" aria-label="Application Ecosystem Overview">
    <div class="showcase-header">
      <span class="showcase-title">Studio Ecosystem</span>
      <span class="showcase-tag">4 Projects Active</span>
    </div>

    <div class="showcase-grid">
      <!-- SignMint -->
      <a href="/apps/signmint/" class="mini-tile">
        <div class="mini-tile-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        </div>
        <div class="mini-tile-info">
          <span class="mini-tile-name">SignMint</span>
          <span class="mini-tile-meta">Productivity &bull; Coming Soon</span>
        </div>
      </a>

      <!-- Ehub -->
      <a href="/apps/ehub/" class="mini-tile">
        <div class="mini-tile-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
        </div>
        <div class="mini-tile-info">
          <span class="mini-tile-name">Ehub</span>
          <span class="mini-tile-meta">Reading &bull; In Dev</span>
        </div>
      </a>

      <!-- PyLab -->
      <a href="/apps/pylab/" class="mini-tile">
        <div class="mini-tile-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5" />
            <line x1="12" y1="19" x2="20" y2="19" />
          </svg>
        </div>
        <div class="mini-tile-info">
          <span class="mini-tile-name">PyLab</span>
          <span class="mini-tile-meta">Education &bull; In Dev</span>
        </div>
      </a>

      <!-- ModelPath ML -->
      <a href="/apps/modelpath-ml/" class="mini-tile">
        <div class="mini-tile-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <circle cx="19" cy="6" r="2" />
            <circle cx="5" cy="6" r="2" />
            <circle cx="19" cy="18" r="2" />
            <circle cx="5" cy="18" r="2" />
          </svg>
        </div>
        <div class="mini-tile-info">
          <span class="mini-tile-name">ModelPath ML</span>
          <span class="mini-tile-meta">Research &bull; Studio Lab</span>
        </div>
      </a>
    </div>
  </aside>
</section>

<script>
  import { initConstellation } from '../scripts/constellation';

  function bootConstellation() {
    document.querySelectorAll<HTMLElement>('[data-constellation]').forEach((el) => initConstellation(el));
  }

  if ('ResizeObserver' in window && 'IntersectionObserver' in window) {
    bootConstellation();
  }
</script>

<style>
  .hero-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto 56px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    position: relative;
    isolation: isolate;
  }

  /* ---- Subtle Constellation layer ---- */
  .hero-constellation {
    position: absolute;
    /* Bleeds into the site-container gutter (48px desktop) — never past the viewport. */
    inset: -36px -48px;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    /* Soft edge fade + reduced intensity behind the headline for legibility. */
    -webkit-mask-image:
      radial-gradient(ellipse 72% 78% at 58% 50%, #000 45%, transparent 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0.6) 32%, #000 62%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 72% 78% at 58% 50%, #000 45%, transparent 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0.6) 32%, #000 62%);
    mask-composite: intersect;
  }

  .constellation-static,
  .constellation-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .constellation-canvas {
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .constellation-static {
    transition: opacity 900ms ease;
  }

  .hero-constellation:global(.is-live) .constellation-canvas {
    opacity: 1;
  }

  .hero-constellation:global(.is-live) .constellation-static {
    opacity: 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: hero-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-showcase {
    animation: hero-rise 700ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: var(--bg-surface);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-inset-box);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-blue);
    flex-shrink: 0;
    animation: badge-breathe 3.6s ease-in-out infinite;
  }

  @keyframes badge-breathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(69, 103, 232, 0.28); }
    50% { box-shadow: 0 0 0 4px rgba(69, 103, 232, 0); }
  }

  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-heading);
    margin-bottom: 18px;
  }

  .hero-subheading {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-body);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
  }

  /* Subordinate Mini Showcase */
  .hero-showcase {
    background: rgba(247, 249, 251, 0.7);
    border-radius: var(--radius-lg);
    box-shadow: -4px -4px 12px #FFFFFF, 4px 4px 14px rgba(169, 180, 196, 0.18);
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  .showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .showcase-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .showcase-tag {
    font-size: 0.75rem;
    color: var(--accent-blue);
    background: var(--bg-inset);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-inset-box);
    font-weight: 600;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .mini-tile {
    background: var(--bg-raised);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-inset-box);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .mini-tile:hover {
    transform: translateX(2px);
  }

  .mini-tile:active {
    transform: translateX(1px) scale(0.985);
  }

  .mini-tile-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: -1px -1px 4px #FFFFFF, 1px 1px 4px rgba(169, 180, 196, 0.22);
    flex-shrink: 0;
  }

  .mini-tile-icon svg {
    width: 16px;
    height: 16px;
    stroke: var(--accent-blue);
  }

  .mini-tile-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mini-tile-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-heading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-tile-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 40px;
    }

    /* Mobile: stay within the 16px gutter and lower overall intensity. */
    .hero-constellation {
      inset: -16px -16px;
      opacity: 0.78;
      -webkit-mask-image:
        radial-gradient(ellipse 85% 70% at 50% 40%, #000 40%, transparent 100%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, #000 55%);
      mask-image:
        radial-gradient(ellipse 85% 70% at 50% 40%, #000 40%, transparent 100%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, #000 55%);
    }

    .hero-cta-group {
      flex-direction: column;
      width: 100%;
    }

    .hero-cta-group :global(a) {
      width: 100%;
    }

    .hero-showcase {
      padding: 18px 16px;
    }

    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .mini-tile {
      padding: 10px;
      gap: 8px;
    }

    .mini-tile-icon {
      width: 26px;
      height: 26px;
    }

    .mini-tile-name {
      font-size: 0.8rem;
    }

    .mini-tile-meta {
      font-size: 0.6875rem;
    }
  }

  @media (max-width: 480px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-showcase,
    .badge-dot {
      animation: none;
    }

    .mini-tile:hover,
    .mini-tile:active {
      transform: none;
    }
  }
</style>
