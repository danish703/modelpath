---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const { href, type = 'button', class: className = '', ariaLabel, disabled = false } = Astro.props;
---

{href && !disabled ? (
  <a href={href} class={`btn-primary ${className}`} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={`btn-primary ${className}`} aria-label={ariaLabel} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--c-cobalt);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 26px;
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 20px -4px rgba(79, 107, 255, 0.45);
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
    border: none;
    text-align: center;
    white-space: nowrap;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--c-cobalt-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgba(79, 107, 255, 0.55);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: 0 4px 12px -2px rgba(79, 107, 255, 0.4);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }
</style>
