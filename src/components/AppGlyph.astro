---
/**
 * AppGlyph — studio-drawn line glyph used as the placeholder app mark until a
 * genuine application icon is supplied via `media.icon`.
 * Consolidates the per-slug SVGs previously duplicated across components.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = '' } = Astro.props;
---

<svg
  class={`app-glyph ${className}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {slug === 'signmint' && (
    <Fragment>
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
    </Fragment>
  )}
  {slug === 'ehub' && (
    <Fragment>
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
    </Fragment>
  )}
  {slug === 'pylab' && (
    <Fragment>
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </Fragment>
  )}
  {slug === 'modelpath-ml' && (
    <Fragment>
      <circle cx="12" cy="12" r="3" />
      <circle cx="19" cy="6" r="2" />
      <circle cx="5" cy="6" r="2" />
      <circle cx="19" cy="18" r="2" />
      <circle cx="5" cy="18" r="2" />
      <line x1="7" y1="7" x2="10" y2="10" />
      <line x1="17" y1="7" x2="14" y2="10" />
      <line x1="7" y1="17" x2="10" y2="14" />
      <line x1="17" y1="17" x2="14" y2="14" />
    </Fragment>
  )}
  {!['signmint', 'ehub', 'pylab', 'modelpath-ml'].includes(slug) && (
    <Fragment>
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
      <line x1="8" y1="21" x2="16" y2="21" />
      <line x1="12" y1="17" x2="12" y2="21" />
    </Fragment>
  )}
</svg>
