---
/**
 * PlatformDownloads — distinct Google Play and Apple App Store controls (Gate 12B).
 * Renders two professional platform cards conforming to the 5-state store control architecture.
 * Direct store links are enabled ONLY when a schema-validated verified store URL exists.
 */
import type { PlatformAvailability } from '../lib/appMedia';

interface Props {
  appName: string;
  platforms: PlatformAvailability[];
}

const { appName, platforms } = Astro.props;

// Helper to determine status badge class
const getBadgeClass = (status: string) => {
  switch (status) {
    case 'published': return 'published';
    case 'coming-soon': return 'coming-soon';
    case 'in-development': return 'in-dev';
    case 'not-planned': return 'not-planned';
    default: return 'unconfirmed';
  }
};
---

<div class="store-platform-grid">
  {platforms.map((p) => {
    const badgeClass = getBadgeClass(p.status);
    return (
      <div
        class={`platform-card status-${p.status}`}
        data-platform={p.platform}
        data-store-state={p.enabled ? 'enabled' : 'disabled'}
        data-reveal
      >
        <div>
          <div class="platform-card-header">
            <div class="platform-brand-badge">
              <div class={`platform-icon-frame ${p.platform}`} aria-hidden="true">
                {p.platform === 'android' ? (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9992.4482.9992.9993 0 .5511-.4482.9997-.9992.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.996-3.4572c.1147-.1994.0463-.4548-.1532-.5697-.1994-.1149-.4548-.0465-.5697.1532l-2.0287 3.5138C15.5398 8.4288 13.8236 8.12 12 8.12c-1.8236 0-3.5398.3088-5.1259.8415L4.8454 5.4477c-.1149-.1997-.3703-.2681-.5697-.1532-.1995.1149-.2679.3703-.1532.5697l1.996 3.4572C2.6889 11.2867.3466 14.7335 0 18.8242h24c-.3466-4.0907-2.6889-7.5375-6.1185-9.5028" />
                  </svg>
                ) : (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.91-2.87-.93.04-2.02.63-2.68 1.4-.59.68-1.11 1.76-.97 2.8 1.03.08 2.08-.54 2.74-1.33z" />
                  </svg>
                )}
              </div>
              <div>
                <h3 class="platform-name">{p.storeName}</h3>
                <span class="platform-os">{p.platformLabel}</span>
              </div>
            </div>
            <span class={`platform-status-badge ${badgeClass}`}>{p.statusLabel}</span>
          </div>

          <p class="platform-body-text">{p.statusDescription}</p>
        </div>

        <div class="platform-btn-container">
          {p.enabled && p.url ? (
            <a
              href={p.url}
              class="store-btn-active"
              target="_blank"
              rel="noopener noreferrer external"
              referrerpolicy="no-referrer"
              aria-label={`${p.storeActionLabel}: ${appName} (opens in a new tab)`}
            >
              <span class="btn-icon" aria-hidden="true">
                {p.platform === 'android' ? (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M3.6 2.4l12.7 12.7-3.7 3.7L2.4 3.6c.4-.6 1.2-1.2 1.2-1.2z" fill="#4F6BFF"/>
                    <path d="M16.3 15.1l3.5-3.5c.8-.8.8-2 0-2.8l-3.5-3.5-3.7 3.7 3.7 3.7z" fill="#73DDE6"/>
                    <path d="M2.4 20.4l10.2-10.2 3.7 3.7L3.6 21.6c-.4 0-.8-.4-1.2-1.2z" fill="#8B5CF6"/>
                  </svg>
                ) : (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.91-2.87-.93.04-2.02.63-2.68 1.4-.59.68-1.11 1.76-.97 2.8 1.03.08 2.08-.54 2.74-1.33z" />
                  </svg>
                )}
              </span>
              <div class="btn-text-col">
                <span class="btn-sub-label">{p.platform === 'android' ? 'Get it on' : 'Download on the'}</span>
                <span class="btn-main-label">{p.storeName} &rarr;</span>
              </div>
            </a>
          ) : (
            <div class={`store-btn-disabled-block ${badgeClass}`} aria-disabled="true">
              <span class="btn-icon" aria-hidden="true">
                {p.platform === 'android' ? (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M3.6 2.4l12.7 12.7-3.7 3.7L2.4 3.6c.4-.6 1.2-1.2 1.2-1.2z" fill="#4F6BFF"/>
                    <path d="M16.3 15.1l3.5-3.5c.8-.8.8-2 0-2.8l-3.5-3.5-3.7 3.7 3.7 3.7z" fill="#73DDE6"/>
                    <path d="M2.4 20.4l10.2-10.2 3.7 3.7L3.6 21.6c-.4 0-.8-.4-1.2-1.2z" fill="#8B5CF6"/>
                  </svg>
                ) : (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.91-2.87-.93.04-2.02.63-2.68 1.4-.59.68-1.11 1.76-.97 2.8 1.03.08 2.08-.54 2.74-1.33z" />
                  </svg>
                )}
              </span>
              <div class="btn-text-col">
                <span class="btn-sub-label">
                  {p.status === 'coming-soon' ? 'Release Pending' : p.status === 'not-planned' ? 'No Active Roadmap' : 'In Development'}
                </span>
                <span class="btn-main-label">{p.storeName} &bull; {p.statusLabel}</span>
              </div>
            </div>
          )}
          <div class="platform-link-note">
            {p.enabled && p.url
              ? 'Official Store Link Verified'
              : p.status === 'coming-soon'
              ? 'Official Store Link Pending Review'
              : p.status === 'not-planned'
              ? 'No Release Scheduled'
              : 'Store Verification Pending'}
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  .store-platform-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    width: 100%;
  }

  .platform-card {
    background: #FFFFFF;
    border-radius: var(--radius-card);
    border: 1px solid rgba(203, 213, 225, 0.8);
    padding: 34px 30px;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .platform-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px rgba(15, 23, 42, 0.08);
  }

  .platform-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .platform-brand-badge {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .platform-icon-frame {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .platform-icon-frame.android {
    background: #EFF6FF;
    color: var(--c-cobalt);
  }

  .platform-icon-frame.ios {
    background: #F1F5F9;
    color: #475569;
  }

  .platform-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c-text-dark);
    margin: 0;
    line-height: 1.2;
  }

  .platform-os {
    font-size: 0.78rem;
    color: #64748B;
  }

  .platform-status-badge {
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .platform-status-badge.coming-soon {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
  }

  .platform-status-badge.not-planned {
    background: #F1F5F9;
    color: #64748B;
    border: 1px solid #CBD5E1;
  }

  .platform-status-badge.in-dev {
    background: #EFF6FF;
    color: #1E40AF;
    border: 1px solid #BFDBFE;
  }

  .platform-status-badge.published {
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }

  .platform-body-text {
    font-size: 0.94rem;
    color: var(--c-text-dark-muted);
    line-height: 1.6;
    margin-top: 14px;
    margin-bottom: 0;
  }

  .platform-btn-container {
    margin-top: 8px;
  }

  .store-btn-active {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: 12px;
    background: var(--c-midnight);
    color: #FFFFFF;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(11, 18, 37, 0.3);
    border: 1px solid rgba(79, 107, 255, 0.3);
    transition: all var(--transition-fast);
  }

  .store-btn-active:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(11, 18, 37, 0.45);
  }

  .store-btn-disabled-block {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: 12px;
    cursor: not-allowed;
    user-select: none;
  }

  .store-btn-disabled-block.coming-soon {
    background: #111A33;
    color: #CBD5E1;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .store-btn-disabled-block.not-planned {
    background: #F8FAFC;
    color: #94A3B8;
    border: 1px solid #CBD5E1;
  }

  .store-btn-disabled-block.in-dev {
    background: #111A33;
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  .btn-text-col {
    text-align: left;
  }

  .btn-sub-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
  }

  .btn-main-label {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .platform-link-note {
    font-size: 0.78rem;
    color: #64748B;
    text-align: center;
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .store-platform-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .platform-card {
      padding: 24px 20px;
      gap: 18px;
    }
    .platform-name {
      font-size: 1.25rem;
    }
    .platform-os {
      font-size: 0.82rem;
    }
    .platform-status-badge {
      font-size: 0.8rem;
      padding: 5px 12px;
    }
    .platform-body-text {
      font-size: 1rem;
      line-height: 1.6;
      margin-top: 12px;
    }
    .store-btn-active,
    .store-btn-disabled-block {
      min-height: 48px;
      padding: 12px 18px;
    }
    .btn-sub-label {
      font-size: 0.74rem;
    }
    .btn-main-label {
      font-size: 1rem;
    }
    .platform-link-note {
      font-size: 0.85rem;
      margin-top: 10px;
    }
  }
</style>
