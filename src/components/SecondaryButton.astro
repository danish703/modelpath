---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const { href, type = 'button', class: className = '', ariaLabel, disabled = false } = Astro.props;
---

{href && !disabled ? (
  <a href={href} class={`btn-secondary ${className}`} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={`btn-secondary ${className}`} aria-label={ariaLabel} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(23, 36, 65, 0.85);
    color: var(--c-text-light);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(79, 107, 255, 0.3);
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
  }

  .btn-secondary:hover:not(:disabled) {
    background: rgba(30, 48, 86, 0.95);
    border-color: var(--c-cobalt);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(79, 107, 255, 0.25);
  }

  .btn-secondary:active:not(:disabled) {
    transform: translateY(0);
  }

  .btn-secondary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    border-color: rgba(255, 255, 255, 0.1);
  }
</style>
