---
interface Props {
  availablePlatforms?: string[];
  plannedPlatforms?: string[];
  customText?: string;
  theme?: 'light' | 'dark';
}

const { availablePlatforms = [], plannedPlatforms = [], customText, theme = 'light' } = Astro.props;

let displayText = customText;

if (!displayText) {
  if (availablePlatforms.length > 0) {
    const formatted = availablePlatforms.map(p => p === 'ios' ? 'iOS' : 'Android').join(' & ');
    displayText = `Available: ${formatted}`;
  } else if (plannedPlatforms.length > 0) {
    if (plannedPlatforms.length === 1 && plannedPlatforms[0] === 'android') {
      displayText = 'Target: Android (In Preparation)';
    } else {
      const formatted = plannedPlatforms.map(p => p === 'ios' ? 'iOS' : 'Android').join(' & ');
      displayText = `Target: ${formatted}`;
    }
  } else {
    displayText = 'Platforms: To be confirmed';
  }
}
---

<span class={`platform-badge theme-${theme}`}>
  <svg class="device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
    <line x1="12" y1="18" x2="12.01" y2="18" />
  </svg>
  <span>{displayText}</span>
</span>

<style>
  .platform-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    width: fit-content;
  }

  .device-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .theme-light {
    background: #F1F5F9;
    color: #475569;
    border: 1px solid #CBD5E1;
  }
  .theme-light .device-icon {
    stroke: #64748B;
  }

  .theme-dark {
    background: rgba(79, 107, 255, 0.12);
    color: #93C5FD;
    border: 1px solid rgba(79, 107, 255, 0.28);
  }
  .theme-dark .device-icon {
    stroke: #73DDE6;
  }
</style>
