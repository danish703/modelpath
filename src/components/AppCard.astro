---
import StatusBadge from './StatusBadge.astro';
import PlatformBadge from './PlatformBadge.astro';
import AppIcon from './AppIcon.astro';
import AppCover from './AppCover.astro';
import type { ImageAsset } from '../lib/appMedia';

interface Props {
  app: {
    slug: string;
    name: string;
    category: string;
    description: string;
    status: 'published' | 'coming-soon' | 'in-development' | 'unconfirmed' | string;
    availablePlatforms?: string[];
    plannedPlatforms?: string[];
    icon?: ImageAsset | null;
    cover?: ImageAsset | null;
  };
  highlightMl?: boolean;
}

const { app, highlightMl = false } = Astro.props;
const isMl = highlightMl || app.slug === 'modelpath-ml' || app.status === 'unconfirmed';
---

<article
  class={`app-card ${isMl ? 'highlight-ml' : ''}`}
  data-app-card
  data-category={app.category.toLowerCase()}
  data-reveal
>
  <!-- Thumbnail (duplicate link removed from tab order; title link is the primary target) -->
  <a href={`/apps/${app.slug}/`} class="card-cover-link" tabindex="-1" aria-hidden="true">
    <AppCover slug={app.slug} name={app.name} cover={app.cover ?? null} variant="card" />
  </a>

  <div class="card-body">
    <div class="card-top">
      <AppIcon slug={app.slug} name={app.name} icon={app.icon ?? null} size="md" class="card-icon" />
      <StatusBadge status={app.status} />
    </div>

    <div class="card-meta">
      <span class="app-category">{app.category}</span>
      <h3 class="app-name">
        <a href={`/apps/${app.slug}/`}>{app.name}</a>
      </h3>
    </div>

    <p class="app-description">{app.description}</p>

    <div class="card-bottom">
      <div class="platform-row">
        <PlatformBadge
          availablePlatforms={app.availablePlatforms}
          plannedPlatforms={app.plannedPlatforms}
        />
      </div>

      <div class="actions-row">
        <div class="sublinks-group">
          <a href={`/apps/${app.slug}/privacy/`} class="card-sublink">Privacy</a>
          <a href={`/apps/${app.slug}/support/`} class="card-sublink">Support</a>
        </div>
        <a href={`/apps/${app.slug}/`} class="btn-explore-app" aria-label={`Explore ${app.name}`}>
          <span>Explore App</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .app-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 14px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.85);
    position: relative;
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .app-card[hidden] {
    display: none;
  }

  .app-card.highlight-ml {
    border-left: 3px solid var(--accent-blue);
  }

  .app-card:hover {
    transform: translateY(-4px);
    box-shadow: -10px -10px 26px #FFFFFF, 12px 14px 30px rgba(169, 180, 196, 0.34);
  }

  .app-card:focus-within {
    box-shadow: var(--shadow-card), 0 0 0 2px rgba(69, 103, 232, 0.55);
  }

  .card-cover-link {
    display: block;
    border-radius: var(--radius-md);
  }

  .app-card:hover :global(.app-cover img) {
    transform: scale(1.03);
  }

  .app-card:hover :global(.cover-mark) {
    transform: translateY(-3px);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0 18px 18px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: -28px;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }

  .app-card:hover :global(.card-icon) {
    transform: translateY(-2px);
  }

  .card-meta {
    margin-bottom: 8px;
  }

  .app-category {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 4px;
  }

  .app-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0;
  }

  .app-name a {
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }

  .app-name a:hover {
    color: var(--accent-blue);
  }

  .app-description {
    font-size: 0.975rem;
    color: var(--text-body);
    line-height: 1.6;
    margin-bottom: 22px;
    flex: 1;
  }

  .card-bottom {
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .platform-row {
    display: flex;
    align-items: center;
  }

  .actions-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sublinks-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-sublink {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .card-sublink:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .btn-explore-app {
    background: var(--bg-raised);
    color: var(--accent-blue);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn-secondary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
  }

  .btn-explore-app:hover {
    transform: translateY(-1px);
    box-shadow: -4px -4px 10px #FFFFFF, 4px 5px 14px rgba(169, 180, 196, 0.32);
  }

  .btn-explore-app:active {
    transform: translateY(0) scale(0.98);
    box-shadow: var(--shadow-inset-box);
  }

  .btn-arrow {
    transition: transform var(--transition-normal);
  }

  .btn-explore-app:hover .btn-arrow {
    transform: translateX(2px);
  }

  @media (max-width: 600px) {
    .app-card {
      padding: 10px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
    }

    .card-body {
      padding: 0 10px 12px;
    }

    .card-top {
      margin-top: -24px;
      margin-bottom: 12px;
    }

    .app-name {
      font-size: 1.25rem;
    }

    .app-description {
      font-size: 0.875rem;
      margin-bottom: 16px;
    }

    .card-bottom {
      padding-top: 14px;
      gap: 12px;
    }

    .btn-explore-app {
      font-size: 0.85rem;
      padding: 8px 14px;
    }
  }

  @media (hover: none) {
    .app-card:hover {
      transform: none;
      box-shadow: var(--shadow-card-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card:hover,
    .app-card:hover :global(.app-cover img),
    .app-card:hover :global(.cover-mark),
    .app-card:hover :global(.card-icon),
    .btn-explore-app:hover,
    .btn-explore-app:hover .btn-arrow {
      transform: none;
    }
  }
</style>
