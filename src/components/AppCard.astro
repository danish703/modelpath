---
import StatusBadge from './StatusBadge.astro';
import PlatformBadge from './PlatformBadge.astro';
import AppCover from './AppCover.astro';
import type { ImageAsset } from '../lib/appMedia';

interface Props {
  app: {
    slug: string;
    name: string;
    category: string;
    description: string;
    status: 'published' | 'coming-soon' | 'in-development' | 'unconfirmed' | string;
    availablePlatforms?: string[];
    plannedPlatforms?: string[];
    icon?: ImageAsset | null;
    cover?: ImageAsset | null;
  };
  highlightMl?: boolean;
}

const { app, highlightMl = false } = Astro.props;
const isMl = highlightMl || app.slug === 'modelpath-ml' || app.status === 'unconfirmed';
---

<article
  class={`app-card ${isMl ? 'highlight-ml' : ''}`}
  data-app-card
  data-category={app.category.toLowerCase()}
  data-reveal
>
  <!-- Thumbnail link (tabindex -1 so title link remains primary accessible target) -->
  <a href={`/apps/${app.slug}/`} class="card-cover-link" tabindex="-1" aria-hidden="true">
    <AppCover slug={app.slug} name={app.name} cover={app.cover ?? null} variant="card" />
  </a>

  <div class="card-body">
    <div class="card-meta-row">
      <span class="app-category">{app.category}</span>
      <StatusBadge status={app.status} size="sm" theme="light" />
    </div>

    <h3 class="app-name">
      <a href={`/apps/${app.slug}/`}>{app.name}</a>
    </h3>

    <p class="app-description">{app.description}</p>

    <div class="card-footer">
      <PlatformBadge
        availablePlatforms={app.availablePlatforms}
        plannedPlatforms={app.plannedPlatforms}
        theme="light"
      />

      <div class="card-actions">
        <a href={`/apps/${app.slug}/privacy/`} class="card-sublink">Privacy</a>
        <a href={`/apps/${app.slug}/support/`} class="card-sublink">Support</a>
        <a href={`/apps/${app.slug}/`} class="btn-explore" aria-label={`View details for ${app.name}`}>
          <span>View Details</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .app-card {
    background: #FFFFFF;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border-light);
    box-shadow: var(--shadow-card-light);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .app-card[hidden] {
    display: none;
  }

  .app-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 35px -5px rgba(15, 23, 42, 0.10);
    border-color: rgba(79, 107, 255, 0.4);
  }

  .card-cover-link {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 8px;
  }

  .app-category {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cobalt);
  }

  .app-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .app-name a {
    color: var(--c-text-dark);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .app-name a:hover {
    color: var(--c-cobalt);
  }

  .app-description {
    font-size: 0.94rem;
    color: var(--c-text-dark-muted);
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--c-border-light-subtle);
    gap: 12px;
    flex-wrap: wrap;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-sublink {
    font-size: 0.82rem;
    font-weight: 500;
    color: #64748B;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-sublink:hover {
    color: var(--c-cobalt);
  }

  .btn-explore {
    background: var(--c-cobalt);
    color: #FFFFFF;
    font-size: 0.86rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all var(--transition-fast);
  }

  .btn-explore:hover {
    background: var(--c-cobalt-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(79, 107, 255, 0.35);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .btn-explore:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .card-body {
      padding: 20px 18px;
    }
    .app-name {
      font-size: 1.35rem;
      margin-bottom: 8px;
    }
    .app-description {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 18px;
    }
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .card-actions {
      width: 100%;
      justify-content: space-between;
      align-items: center;
    }
    .card-sublink {
      font-size: 0.88rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      padding: 6px 4px;
    }
    .btn-explore {
      min-height: 44px;
      padding: 10px 18px;
      font-size: 0.92rem;
    }
  }
</style>
