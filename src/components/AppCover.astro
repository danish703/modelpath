---
/**
 * AppCover — genuine cover/thumbnail artwork, or a differentiated, conceptual
 * vector cover motif (Gate 12B / Gate 13).
 *
 * Rules:
 * - Published apps (SignMint, ModelPath ML): Render official Google Play icon and genuine product screenshot in a sleek card mockup.
 * - Conceptual apps (PyLab, Ehub): Render differentiated vector motif with clear "Conceptual Preview" label.
 * - Real cover asset: When genuine artwork is provided in `cover`, it seamlessly renders the real image.
 */
import type { ImageAsset } from '../lib/appMedia';

interface Props {
  slug: string;
  name: string;
  cover: ImageAsset | null;
  variant?: 'card' | 'hero';
  eager?: boolean;
  class?: string;
}

const { slug, name, cover, variant = 'card', eager = false, class: className = '' } = Astro.props;

const isPublishedApp = slug === 'signmint' || slug === 'modelpath-ml';

const conceptualLabels: Record<string, string> = {
  ehub: 'Ehub • Conceptual Preview',
  pylab: 'PyLab • Conceptual Preview',
};

const conceptualLabel = conceptualLabels[slug] || `${name} • Conceptual Preview`;
---

<figure
  class={`app-cover variant-${variant} slug-${slug} ${cover || isPublishedApp ? 'is-genuine' : 'is-conceptual'} ${className}`}
  data-media-kind={cover || isPublishedApp ? 'genuine' : 'conceptual'}
>
  {cover ? (
    <img
      src={cover.src}
      alt={cover.alt}
      width={cover.width ?? 1280}
      height={cover.height ?? 800}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : isPublishedApp ? (
    <div class={`genuine-card-stage genuine-${slug}`} aria-label={`${name} official preview`}>
      <div class="genuine-ambient-glow" aria-hidden="true"></div>

      <!-- Official App Icon Floating Badge -->
      <div class="genuine-app-badge">
        <img
          src={`/images/apps/${slug}/icon.png`}
          alt={`${name} official icon`}
          width="40"
          height="40"
          loading="eager"
          decoding="sync"
        />
        <div class="badge-text">
          <span class="badge-app-title">{name}</span>
          <span class="badge-store-pill">Google Play</span>
        </div>
      </div>

      <!-- Real Phone Mockup Displaying Genuine Screenshot -->
      <div class="genuine-phone-mockup" aria-hidden="true">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <img
            src={`/images/apps/${slug}/screenshot-1.png`}
            alt={`${name} official interface screenshot`}
            width="800"
            height="1422"
            loading="eager"
            decoding="sync"
          />
        </div>
      </div>
    </div>
  ) : (
    <div class="conceptual-canvas" aria-hidden="true">
      {slug === 'ehub' && (
        <div class="motif-wrapper motif-ehub">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <path d="M 160 160 Q 270 168 270 45 Q 270 168 380 160 L 370 40 Q 270 45 270 35 Q 270 45 170 40 Z" fill="#17203B" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5"/>
            <path d="M 270 35 L 270 135 L 277 128 L 284 135 L 284 40" fill="#8B5CF6"/>
            <line x1="185" y1="65" x2="250" y2="65" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="185" y1="85" x2="250" y2="85" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="185" y1="105" x2="235" y2="105" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="65" x2="355" y2="65" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="85" x2="355" y2="85" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="105" x2="340" y2="105" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
          </svg>
        </div>
      )}

      {slug === 'pylab' && (
        <div class="motif-wrapper motif-pylab">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <rect x="150" y="30" width="240" height="140" rx="10" fill="#141E38" stroke="rgba(115, 221, 230, 0.35)" stroke-width="1.5"/>
            <circle cx="170" cy="46" r="4" fill="#EF4444"/>
            <circle cx="182" cy="46" r="4" fill="#F59E0B"/>
            <circle cx="194" cy="46" r="4" fill="#10B981"/>
            <line x1="150" y1="60" x2="390" y2="60" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1"/>
            <text x="170" y="88" fill="#73DDE6" font-family="monospace" font-size="12" font-weight="600">&gt;&gt;&gt; def learn():</text>
            <text x="185" y="108" fill="#FFFFFF" font-family="monospace" font-size="12">  code = 'python'</text>
            <text x="185" y="128" fill="#8B5CF6" font-family="monospace" font-size="12">  return code.run()</text>
            <rect x="170" y="142" width="70" height="16" rx="3" fill="rgba(115, 221, 230, 0.2)"/>
            <text x="175" y="154" fill="#73DDE6" font-family="monospace" font-size="10">SUCCESS: 0</text>
          </svg>
        </div>
      )}

      <span class="cover-tag">{conceptualLabel}</span>
    </div>
  )}
</figure>

<style>
  .app-cover {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: #0E162B;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .variant-card {
    height: 190px;
    border-radius: 14px 14px 0 0;
  }

  .variant-hero {
    height: 260px;
    border-radius: var(--radius-inner, 12px);
    border: 1px solid rgba(79, 107, 255, 0.25);
  }

  .app-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Genuine Card Stage (Published Apps) */
  .genuine-card-stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    background: #090F1F;
  }

  .genuine-signmint {
    background: radial-gradient(circle at 75% 45%, rgba(79, 107, 255, 0.35), transparent 70%),
                radial-gradient(circle at 20% 30%, rgba(115, 221, 230, 0.18), transparent 60%),
                #090F1F;
  }

  .genuine-modelpath-ml {
    background: radial-gradient(circle at 75% 45%, rgba(139, 92, 246, 0.35), transparent 70%),
                radial-gradient(circle at 20% 30%, rgba(79, 107, 255, 0.22), transparent 60%),
                #090F1F;
  }

  .genuine-app-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2;
    background: rgba(14, 22, 43, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px 6px 8px;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  .genuine-app-badge img {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .badge-app-title {
    font-family: var(--font-display, inherit);
    font-size: 0.85rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    white-space: nowrap;
  }

  .badge-store-pill {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--c-cyan, #73DDE6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .genuine-phone-mockup {
    position: relative;
    width: 124px;
    height: 200px;
    background: #000000;
    border: 2.5px solid rgba(255, 255, 255, 0.18);
    border-bottom: none;
    border-radius: 18px 18px 0 0;
    transform: translateY(22px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 16px rgba(79, 107, 255, 0.2);
    overflow: hidden;
    flex-shrink: 0;
    z-index: 1;
    margin-right: 4px;
  }

  .phone-notch {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
    z-index: 3;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Conceptual Canvas (Unreleased Apps) */
  .conceptual-canvas {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .motif-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .motif-ehub {
    background: radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.25), transparent 70%), #0E162B;
  }

  .motif-pylab {
    background: radial-gradient(circle at 50% 50%, rgba(115, 221, 230, 0.2), transparent 70%), #0E162B;
  }

  .cover-tag {
    position: absolute;
    bottom: 12px;
    right: 14px;
    background: rgba(11, 18, 37, 0.85);
    border: 1px solid rgba(79, 107, 255, 0.3);
    color: #CBD5E1;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill, 9999px);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .variant-card {
      height: 160px;
    }
    .variant-hero {
      height: 200px;
    }
    .cover-tag {
      font-size: 0.68rem;
      bottom: 8px;
      right: 10px;
      padding: 2px 8px;
    }
    .genuine-card-stage {
      padding: 0 14px;
    }
    .genuine-app-badge {
      padding: 4px 10px 4px 6px;
      gap: 8px;
    }
    .genuine-app-badge img {
      width: 30px;
      height: 30px;
      border-radius: 7px;
    }
    .badge-app-title {
      font-size: 0.76rem;
    }
    .badge-store-pill {
      font-size: 0.58rem;
    }
    .genuine-phone-mockup {
      width: 96px;
      height: 165px;
      transform: translateY(18px);
    }
  }
</style>
