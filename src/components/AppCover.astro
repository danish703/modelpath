---
/**
 * AppCover — genuine cover/thumbnail artwork, or a differentiated, conceptual
 * vector cover motif (Gate 12B Midnight Aurora).
 *
 * Rules:
 * - Differentiated conceptual treatments per app motif:
 *   • SignMint: PDF signing & document annotation motif (Electric Cobalt & Soft Cyan)
 *   • Ehub: Digital reading & book spread motif (Aurora Violet)
 *   • PyLab: Python interactive coding & syntax motif (Soft Cyan)
 *   • ModelPath ML: Abstract machine-learning / neural lattice motif (Cobalt & Violet)
 * - Clearly labeled as decorative conceptual preview artwork, never disguised as product screenshots.
 * - Content-driven: When genuine artwork is provided in `media.cover`, it seamlessly renders the real image.
 */
import type { ImageAsset } from '../lib/appMedia';

interface Props {
  slug: string;
  name: string;
  cover: ImageAsset | null;
  variant?: 'card' | 'hero';
  eager?: boolean;
  class?: string;
}

const { slug, name, cover, variant = 'card', eager = false, class: className = '' } = Astro.props;

const conceptualLabels: Record<string, string> = {
  signmint: 'SignMint • Conceptual Preview',
  ehub: 'Ehub • Conceptual Preview',
  pylab: 'PyLab • Conceptual Preview',
  'modelpath-ml': 'ModelPath ML • Conceptual Preview',
};

const conceptualLabel = conceptualLabels[slug] || `${name} • Conceptual Preview`;
---

<figure
  class={`app-cover variant-${variant} slug-${slug} ${cover ? 'is-genuine' : 'is-conceptual'} ${className}`}
  data-media-kind={cover ? 'genuine' : 'conceptual'}
>
  {cover ? (
    <img
      src={cover.src}
      alt={cover.alt}
      width={cover.width ?? 1280}
      height={cover.height ?? 800}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class="conceptual-canvas" aria-hidden="true">
      {slug === 'signmint' && (
        <div class="motif-wrapper motif-signmint">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <rect x="180" y="30" width="180" height="140" rx="10" fill="#17203B" stroke="rgba(79, 107, 255, 0.4)" stroke-width="1.5"/>
            <line x1="205" y1="52" x2="300" y2="52" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="205" y1="72" x2="335" y2="72" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2" stroke-linecap="round"/>
            <line x1="205" y1="92" x2="310" y2="92" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2" stroke-linecap="round"/>
            <rect x="205" y="115" width="130" height="38" rx="6" fill="#10172D" stroke="rgba(79, 107, 255, 0.3)" stroke-dasharray="3 3"/>
            <path d="M 215 140 Q 240 120 255 135 T 290 130 T 325 137" stroke="#4F6BFF" stroke-width="3.5" stroke-linecap="round" fill="none"/>
            <circle cx="325" cy="140" r="13" fill="rgba(79, 107, 255, 0.2)" stroke="#73DDE6" stroke-width="2"/>
          </svg>
        </div>
      )}

      {slug === 'ehub' && (
        <div class="motif-wrapper motif-ehub">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <path d="M 160 160 Q 270 168 270 45 Q 270 168 380 160 L 370 40 Q 270 45 270 35 Q 270 45 170 40 Z" fill="#17203B" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5"/>
            <path d="M 270 35 L 270 135 L 277 128 L 284 135 L 284 40" fill="#8B5CF6"/>
            <line x1="185" y1="65" x2="250" y2="65" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="185" y1="85" x2="250" y2="85" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="185" y1="105" x2="235" y2="105" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="65" x2="355" y2="65" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="85" x2="355" y2="85" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
            <line x1="295" y1="105" x2="340" y2="105" stroke="rgba(255, 255, 255, 0.2)" stroke-width="2"/>
          </svg>
        </div>
      )}

      {slug === 'pylab' && (
        <div class="motif-wrapper motif-pylab">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <rect x="150" y="30" width="240" height="140" rx="10" fill="#141E38" stroke="rgba(115, 221, 230, 0.35)" stroke-width="1.5"/>
            <circle cx="170" cy="46" r="4" fill="#EF4444"/>
            <circle cx="182" cy="46" r="4" fill="#F59E0B"/>
            <circle cx="194" cy="46" r="4" fill="#10B981"/>
            <line x1="150" y1="60" x2="390" y2="60" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1"/>
            <text x="170" y="88" fill="#73DDE6" font-family="monospace" font-size="12" font-weight="600">&gt;&gt;&gt; def learn():</text>
            <text x="185" y="108" fill="#FFFFFF" font-family="monospace" font-size="12">  code = 'python'</text>
            <text x="185" y="128" fill="#8B5CF6" font-family="monospace" font-size="12">  return code.run()</text>
            <rect x="170" y="142" width="70" height="16" rx="3" fill="rgba(115, 221, 230, 0.2)"/>
            <text x="175" y="154" fill="#73DDE6" font-family="monospace" font-size="10">SUCCESS: 0</text>
          </svg>
        </div>
      )}

      {slug === 'modelpath-ml' && (
        <div class="motif-wrapper motif-ml">
          <svg viewBox="0 0 540 200" width="100%" height="100%" fill="none" preserveAspectRatio="xMidYMid meet">
            <!-- Interconnecting lines -->
            <line x1="190" y1="60" x2="270" y2="40" stroke="rgba(79, 107, 255, 0.35)" stroke-width="1.5"/>
            <line x1="190" y1="60" x2="270" y2="80" stroke="rgba(79, 107, 255, 0.35)" stroke-width="1.5"/>
            <line x1="190" y1="100" x2="270" y2="80" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5"/>
            <line x1="190" y1="100" x2="270" y2="120" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5"/>
            <line x1="190" y1="140" x2="270" y2="120" stroke="rgba(79, 107, 255, 0.35)" stroke-width="1.5"/>
            <line x1="190" y1="140" x2="270" y2="160" stroke="rgba(79, 107, 255, 0.35)" stroke-width="1.5"/>
            <line x1="270" y1="40" x2="350" y2="70" stroke="rgba(115, 221, 230, 0.4)" stroke-width="1.5"/>
            <line x1="270" y1="80" x2="350" y2="70" stroke="rgba(115, 221, 230, 0.4)" stroke-width="1.5"/>
            <line x1="270" y1="120" x2="350" y2="130" stroke="rgba(115, 221, 230, 0.4)" stroke-width="1.5"/>
            <line x1="270" y1="160" x2="350" y2="130" stroke="rgba(115, 221, 230, 0.4)" stroke-width="1.5"/>
            <!-- Layer 1 -->
            <circle cx="190" cy="60" r="10" fill="#141E38" stroke="#4F6BFF" stroke-width="2"/>
            <circle cx="190" cy="100" r="10" fill="#141E38" stroke="#4F6BFF" stroke-width="2"/>
            <circle cx="190" cy="140" r="10" fill="#141E38" stroke="#4F6BFF" stroke-width="2"/>
            <!-- Layer 2 -->
            <circle cx="270" cy="40" r="10" fill="#172441" stroke="#8B5CF6" stroke-width="2"/>
            <circle cx="270" cy="80" r="10" fill="#172441" stroke="#8B5CF6" stroke-width="2"/>
            <circle cx="270" cy="120" r="10" fill="#172441" stroke="#8B5CF6" stroke-width="2"/>
            <circle cx="270" cy="160" r="10" fill="#172441" stroke="#8B5CF6" stroke-width="2"/>
            <!-- Layer 3 -->
            <circle cx="350" cy="70" r="11" fill="#101A33" stroke="#73DDE6" stroke-width="2"/>
            <circle cx="350" cy="130" r="11" fill="#101A33" stroke="#73DDE6" stroke-width="2"/>
          </svg>
        </div>
      )}

      <span class="cover-tag">{conceptualLabel}</span>
    </div>
  )}
</figure>

<style>
  .app-cover {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: #0E162B;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .variant-card {
    height: 190px;
    border-radius: 14px 14px 0 0;
  }

  .variant-hero {
    height: 260px;
    border-radius: var(--radius-inner);
    border: 1px solid rgba(79, 107, 255, 0.25);
  }

  .app-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .conceptual-canvas {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .motif-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .motif-signmint {
    background: radial-gradient(circle at 50% 50%, rgba(79, 107, 255, 0.25), transparent 70%), #0E162B;
  }

  .motif-ehub {
    background: radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.25), transparent 70%), #0E162B;
  }

  .motif-pylab {
    background: radial-gradient(circle at 50% 50%, rgba(115, 221, 230, 0.2), transparent 70%), #0E162B;
  }

  .motif-ml {
    background: radial-gradient(circle at 50% 50%, rgba(79, 107, 255, 0.2), rgba(139, 92, 246, 0.2), transparent 70%), #0E162B;
  }

  .cover-tag {
    position: absolute;
    bottom: 12px;
    right: 14px;
    background: rgba(11, 18, 37, 0.85);
    border: 1px solid rgba(79, 107, 255, 0.3);
    color: #CBD5E1;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .variant-card {
      height: 160px;
    }
    .variant-hero {
      height: 200px;
    }
    .cover-tag {
      font-size: 0.68rem;
      bottom: 8px;
      right: 10px;
      padding: 2px 8px;
    }
  }
</style>
