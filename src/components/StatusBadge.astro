---
interface Props {
  status: 'published' | 'coming-soon' | 'in-development' | 'unconfirmed' | string;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;

const labelMap: Record<string, string> = {
  'coming-soon': 'Coming Soon',
  'in-development': 'In Development',
  'unconfirmed': 'Unconfirmed',
  'published': 'Published',
};

const displayLabel = labelMap[status] || status;
---

<span class={`status-badge size-${size} status-${status}`}>
  {displayLabel}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--bg-inset);
    color: var(--text-muted);
    box-shadow: var(--shadow-inset-box);
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .size-sm {
    font-size: 0.725rem;
    padding: 4px 10px;
  }

  .size-md {
    font-size: 0.8rem;
    padding: 6px 14px;
  }

  .status-coming-soon {
    color: var(--accent-blue);
  }

  .status-published {
    color: var(--color-status-published, #0D9488);
  }

  .status-in-development {
    color: var(--text-muted);
  }

  .status-unconfirmed {
    color: var(--text-muted);
  }
</style>
