---
interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  theme?: 'dark' | 'light';
}

const { label, title, description, align = 'left', as: Tag = 'h2', theme = 'light' } = Astro.props;
---

<div class={`section-heading align-${align} theme-${theme}`}>
  {label && <div class="section-label">{label}</div>}
  <Tag class="section-title">{title}</Tag>
  {description && <p class="section-description">{description}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 32px;
    width: 100%;
  }

  .align-center {
    text-align: center;
  }

  .align-center .section-description {
    margin-left: auto;
    margin-right: auto;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-cobalt);
    margin-bottom: 8px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .section-description {
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 680px;
  }

  .theme-light .section-title {
    color: var(--c-text-dark);
  }
  .theme-light .section-description {
    color: var(--c-text-dark-muted);
  }

  .theme-dark .section-title {
    color: #FFFFFF;
  }
  .theme-dark .section-description {
    color: var(--c-text-light-muted);
  }
</style>
