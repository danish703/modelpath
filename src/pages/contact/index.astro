---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with ModelPath studio for app inquiries, support, and feedback.">
  <article>
    <header style="margin-bottom: 2rem;">
      <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">Contact ModelPath</h1>
      <p style="color: var(--color-text-secondary); font-size: 1.125rem;">
        We welcome questions, suggestions, partnership discussions, and direct feedback about our software.
      </p>
    </header>

    <div style="padding: 2rem; background: var(--color-bg-surface); border-radius: var(--radius-md); box-shadow: var(--shadow-raised-sm); max-width: 540px;">
      <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Direct Studio Inquiries</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: 1.25rem;">
        Email is our primary communication channel. Please direct inquiries to:
      </p>
      <p style="font-size: 1.25rem; margin-bottom: 1rem;">
        <a href="mailto:hello@modelpath.app" style="font-weight: 600;">hello@modelpath.app</a>
      </p>
      <p style="font-size: 0.875rem; color: var(--color-text-muted);">
        For technical assistance with an individual application, you may also email <a href="mailto:support@modelpath.app">support@modelpath.app</a>.
      </p>
    </div>
  </article>
</BaseLayout>
