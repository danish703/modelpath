---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { studioContactConfig } from '../../data/studioContact';
import { getCollection } from 'astro:content';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Contact ModelPath Studio"
  description="Get in touch with ModelPath Studio for general inquiries, technical support, partnerships, and user feedback."
>
  <div class="contact-page">
    <!-- Dark Atmospheric Hero -->
    <header class="contact-hero">
      <div class="container">
        <div class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>{studioContactConfig.tagline}</span>
        </div>
        <h1 class="hero-title">Contact ModelPath Studio</h1>
        <p class="hero-intro">
          {studioContactConfig.intro}
        </p>
      </div>
    </header>

    <!-- Editorial Canvas Section -->
    <main class="editorial-canvas">
      <div class="container">
        <!-- Direct Inquiry Channels -->
        <section class="section-block" aria-labelledby="channels-heading">
          <div class="section-header">
            <span class="section-label">Communication Channels</span>
            <h2 id="channels-heading" class="section-title">Direct Studio Inquiries</h2>
          </div>

          <div class="channels-grid">
            {studioContactConfig.channels.map((channel) => (
              <div class="channel-card">
                <div class="channel-card-top">
                  <div class="channel-icon-well" aria-hidden="true">
                    {channel.purpose === 'General' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                      </svg>
                    )}
                    {channel.purpose === 'Support' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                      </svg>
                    )}
                    {channel.purpose === 'Privacy' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                    )}
                  </div>
                  <div class="channel-tags-group">
                    <span class="channel-tag">{channel.purpose}</span>
                  </div>
                </div>

                <h3 class="channel-name">{channel.label}</h3>
                <p class="channel-desc">{channel.description}</p>

                <div class="channel-action">
                  <a
                    href={`mailto:${channel.email}?subject=[${channel.purpose}] Inquiry for ModelPath Studio`}
                    class="channel-email-btn"
                    aria-label={`Send email to ${channel.email} for ${channel.label}`}
                  >
                    <span>{channel.email}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- App Support Navigation Section -->
        <section class="section-block" aria-labelledby="app-support-heading">
          <div class="section-header">
            <span class="section-label">Product Assistance</span>
            <h2 id="app-support-heading" class="section-title">Application Support Hubs</h2>
            <p class="section-subtext">
              Looking for troubleshooting guidance, pre-release FAQs, or application-specific disclosures? Access dedicated support resources for each app:
            </p>
          </div>

          <div class="app-support-grid">
            {apps.map((app) => (
              <div class="app-support-card">
                <div class="app-support-card-content">
                  <div class="app-icon-well" aria-hidden="true">
                    {app.data.slug === 'signmint' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                      </svg>
                    )}
                    {app.data.slug === 'ehub' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                      </svg>
                    )}
                    {app.data.slug === 'pylab' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 17 10 11 4 5" />
                        <line x1="12" y1="19" x2="20" y2="19" />
                      </svg>
                    )}
                    {app.data.slug === 'modelpath-ml' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <circle cx="19" cy="6" r="2" />
                        <circle cx="5" cy="6" r="2" />
                        <circle cx="19" cy="18" r="2" />
                        <circle cx="5" cy="18" r="2" />
                      </svg>
                    )}
                  </div>
                  <div class="app-support-info">
                    <span class="app-support-category">{app.data.category}</span>
                    <h3 class="app-support-title">{app.data.name}</h3>
                    <p class="app-support-desc">{app.data.tagline}</p>
                  </div>
                </div>

                <div class="app-support-actions">
                  <a href={`/apps/${app.data.slug}/support/`} class="btn-app-support">
                    <span>View Support &amp; FAQ</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                  <a href={`/apps/${app.data.slug}/privacy/`} class="link-app-privacy">
                    <span>{app.data.privacyPolicyStatus === 'verified' ? 'Privacy Policy' : 'Privacy (Draft Disclosures)'}</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Operational Note Well -->
        <aside class="operational-notice-well" aria-label="Studio Operations Notice">
          <div class="notice-icon-well" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
          </div>
          <div class="notice-content">
            <strong class="notice-title">Studio Operational Notice</strong>
            <p class="notice-text">
              {studioContactConfig.routingNotice}
            </p>
            <p class="notice-text note-secondary">
              {studioContactConfig.postalAddressNote}
            </p>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .contact-page {
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Contact Hero (Dark Atmospheric) */
  .contact-hero {
    padding-top: 64px;
    padding-bottom: 72px;
    background: radial-gradient(circle at 50% 20%, rgba(79, 107, 255, 0.18) 0%, rgba(139, 92, 246, 0.08) 50%, transparent 75%), var(--c-midnight, #0B1225);
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(23, 36, 65, 0.85);
    border: 1px solid rgba(79, 107, 255, 0.25);
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-cyan, #73DDE6);
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-cyan, #73DDE6);
  }

  .hero-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #FFFFFF;
    margin: 0 auto 16px;
    max-width: 780px;
  }

  .hero-intro {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--c-text-light-muted, #94A3B8);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 680px;
  }

  /* Editorial Canvas */
  .editorial-canvas {
    background: var(--c-offwhite, #F8FAFC);
    color: var(--c-text-dark, #0F172A);
    padding: 72px 0 88px;
  }

  .section-block {
    margin-bottom: 64px;
    width: 100%;
  }

  .section-header {
    margin-bottom: 28px;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 6px;
  }

  .section-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
  }

  .section-subtext {
    font-size: 1rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.6;
    margin: 0;
    max-width: 720px;
  }

  /* Channels Grid */
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .channel-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 32px 28px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .channel-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .channel-icon-well {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(79, 107, 255, 0.1);
    border: 1px solid rgba(79, 107, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-cobalt, #4F6BFF);
  }

  .channel-icon-well svg {
    width: 22px;
    height: 22px;
  }

  .channel-tags-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .channel-status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #047857;
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-pill, 9999px);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .channel-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-cobalt, #4F6BFF);
    background: rgba(79, 107, 255, 0.08);
    padding: 2px 8px;
    border-radius: var(--radius-pill, 9999px);
    border: 1px solid rgba(79, 107, 255, 0.2);
  }

  .channel-name {
    font-family: var(--font-display, inherit);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0;
  }

  .channel-desc {
    font-size: 0.92rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .channel-action {
    margin-top: 8px;
  }

  .channel-email-btn {
    background: var(--c-cobalt, #4F6BFF);
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: var(--radius-pill, 9999px);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(79, 107, 255, 0.3);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .channel-email-btn:hover {
    background: var(--c-cobalt-hover, #3D58E6);
    transform: translateY(-1px);
  }

  /* App Support Grid */
  .app-support-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .app-support-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 28px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .app-support-card-content {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .app-icon-well {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(79, 107, 255, 0.1);
    border: 1px solid rgba(79, 107, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-cobalt, #4F6BFF);
    flex-shrink: 0;
  }

  .app-icon-well svg {
    width: 24px;
    height: 24px;
  }

  .app-support-info {
    flex: 1;
  }

  .app-support-category {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 2px;
  }

  .app-support-title {
    font-family: var(--font-display, inherit);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 4px 0;
  }

  .app-support-desc {
    font-size: 0.9rem;
    color: var(--c-text-dark-muted, #475569);
    margin: 0;
    line-height: 1.5;
  }

  .app-support-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgba(203, 213, 225, 0.5);
    flex-wrap: wrap;
  }

  .btn-app-support {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #FFFFFF;
    background: var(--c-cobalt, #4F6BFF);
    padding: 8px 16px;
    border-radius: var(--radius-pill, 9999px);
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(79, 107, 255, 0.25);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-app-support:hover {
    background: var(--c-cobalt-hover, #3D58E6);
    transform: translateY(-1px);
  }

  .link-app-privacy {
    font-size: 0.82rem;
    color: var(--c-text-dark-muted, #64748B);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .link-app-privacy:hover {
    color: var(--c-cobalt, #4F6BFF);
  }

  /* Operational Notice */
  .operational-notice-well {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    border: 1px solid rgba(203, 213, 225, 0.6);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 24px 28px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .notice-icon-well {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(79, 107, 255, 0.1);
    color: var(--c-cobalt, #4F6BFF);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .notice-icon-well svg {
    width: 20px;
    height: 20px;
  }

  .notice-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .notice-title {
    font-family: var(--font-display, inherit);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--c-text-dark, #0F172A);
  }

  .notice-text {
    font-size: 0.92rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.55;
    margin: 0;
  }

  .note-secondary {
    font-size: 0.85rem;
    color: var(--c-text-dark-muted, #64748B);
  }

  /* Responsive Rules */
  @media (max-width: 860px) {
    .container {
      padding: 0 20px;
    }

    .contact-hero {
      padding-top: 40px;
      padding-bottom: 48px;
    }

    .editorial-canvas {
      padding: 44px 0 60px;
    }

    .channels-grid {
      grid-template-columns: 1fr;
    }

    .app-support-grid {
      grid-template-columns: 1fr;
    }

    .operational-notice-well {
      flex-direction: column;
      padding: 20px;
    }
  }
</style>
