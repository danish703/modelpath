---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AppGrid from '../components/AppGrid.astro';
import { getCollection } from 'astro:content';
import { toCardModel } from '../lib/appMedia';

const rawApps = await getCollection('apps');
const apps = rawApps
  .map((entry) => toCardModel(entry.data))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="ModelPath Studio — Thoughtful Software. Beautifully Built."
  description="ModelPath Studio is an independent software studio creating elegant mobile applications and intelligent digital experiences with a focus on craft and on-device privacy."
>
  <!-- Hero Section (Dark Midnight Aurora) -->
  <HeroSection />

  <!-- Our Applications Section (Editorial Off-White Canvas) -->
  <section class="editorial-showcase-section" aria-labelledby="apps-heading">
    <div class="container" data-reveal>
      <SectionHeading
        label="Software Portfolio"
        title="Our Applications"
        description="Focused software designed for utility, performance, and everyday privacy."
        theme="light"
      />

      <AppGrid apps={apps} />
    </div>
  </section>

  <!-- Studio Philosophy Section (Structured Light Well) -->
  <section class="philosophy-section" id="philosophy" aria-labelledby="philosophy-heading">
    <div class="container" data-reveal>
      <SectionHeading
        label="Principles &amp; Craft"
        title="Studio Philosophy"
        description="Our foundational approach to digital craftsmanship, independent software engineering, and user ergonomics."
        theme="light"
      />

      <div class="philosophy-grid">
        <div class="philo-card">
          <div class="philo-number">01 / ENG</div>
          <h3 class="philo-title">Thoughtful Engineering</h3>
          <p class="philo-text">
            Lightweight static architectures, clean codebases, zero unnecessary background dependencies, and instantaneous loading.
          </p>
        </div>

        <div class="philo-card">
          <div class="philo-number">02 / EXP</div>
          <h3 class="philo-title">Useful Experiences</h3>
          <p class="philo-text">
            Purpose-built digital utilities created to simplify concrete user workflows without artificial engagement metrics.
          </p>
        </div>

        <div class="philo-card">
          <div class="philo-number">03 / UI</div>
          <h3 class="philo-title">Tactile Interfaces</h3>
          <p class="philo-text">
            Carefully calibrated contrast, comfortable touch targets, tactile elevation, and intentional typography.
          </p>
        </div>

        <div class="philo-card">
          <div class="philo-number">04 / ETH</div>
          <h3 class="philo-title">Continuous Polish</h3>
          <p class="philo-text">
            Relentless refinement, rigorous accessibility compliance, and persistent craft standards.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .editorial-showcase-section {
    width: 100%;
    background-color: var(--c-offwhite);
    color: var(--c-text-dark);
    padding: 80px 0;
  }

  .philosophy-section {
    width: 100%;
    background-color: #F1F5F9;
    color: var(--c-text-dark);
    padding: 80px 0;
    border-top: 1px solid var(--c-border-light);
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .philo-card {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(203, 213, 225, 0.7);
    padding: 28px 24px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .philo-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
  }

  .philo-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-cobalt);
    letter-spacing: 0.08em;
  }

  .philo-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-text-dark);
    margin: 0;
  }

  .philo-text {
    font-size: 0.9rem;
    color: var(--c-text-dark-muted);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 960px) {
    .editorial-showcase-section,
    .philosophy-section {
      padding: 60px 0;
    }
    .philosophy-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .editorial-showcase-section,
    .philosophy-section {
      padding: 44px 0;
    }
    .container {
      padding: 0 20px;
    }
    .philosophy-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
