---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const apps = await getCollection('apps');
---

<BaseLayout title="Independent Software Studio">
  <section style="margin-bottom: 3rem;">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Thoughtful Software. Beautifully Built.</h1>
    <p style="font-size: 1.125rem; color: var(--color-text-secondary); max-width: 640px;">
      ModelPath is an independent software studio building intuitive applications that simplify everyday experiences.
    </p>
  </section>

  <section>
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Applications</h2>
    <ul style="list-style: none; display: grid; gap: 1rem;">
      {apps.map((app) => (
        <li style="padding: 1.25rem; background: var(--color-bg-surface); border-radius: var(--radius-md); box-shadow: var(--shadow-raised-sm);">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <h3 style="font-size: 1.25rem;"><a href={`/apps/${app.data.slug}/`}>{app.data.name}</a></h3>
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);">{app.data.status}</span>
          </div>
          <p style="color: var(--color-text-secondary); margin-top: 0.5rem;">{app.data.tagline}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
