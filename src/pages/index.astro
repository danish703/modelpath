---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AppGrid from '../components/AppGrid.astro';
import { getCollection } from 'astro:content';

const rawApps = await getCollection('apps');
const apps = rawApps
  .map((entry) => ({
    slug: entry.data.slug,
    name: entry.data.name,
    category: entry.data.category,
    description: entry.data.description,
    status: entry.data.status,
    availablePlatforms: entry.data.availablePlatforms,
    plannedPlatforms: entry.data.plannedPlatforms,
    order: entry.data.order,
  }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="ModelPath Studio — Thoughtful Software. Beautifully Built."
  description="ModelPath Studio is an independent software studio creating elegant mobile applications and intelligent digital experiences with a focus on craft and on-device privacy."
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Our Applications Section -->
  <section class="section-container" aria-labelledby="apps-heading">
    <SectionHeading
      label="Software Portfolio"
      title="Our Applications"
      description="Focused software designed for utility, performance, and everyday privacy."
    />

    <AppGrid apps={apps} />
  </section>

  <!-- Studio Philosophy Section -->
  <section class="section-container" aria-labelledby="philosophy-heading">
    <SectionHeading
      label="Principles & Craft"
      title="Studio Philosophy"
      description="Our foundational approach to digital craftsmanship and software engineering."
    />

    <div class="philosophy-well">
      <div class="philosophy-card">
        <h3 class="philosophy-title">Thoughtful Engineering</h3>
        <p class="philosophy-desc">
          Lightweight static architectures, clean codebases, and instantaneous loading.
        </p>
      </div>

      <div class="philosophy-card">
        <h3 class="philosophy-title">Useful Experiences</h3>
        <p class="philosophy-desc">
          Purpose-built digital utilities created to simplify concrete user workflows.
        </p>
      </div>

      <div class="philosophy-card">
        <h3 class="philosophy-title">Tactile Interfaces</h3>
        <p class="philosophy-desc">
          Subtle 3D depth, comfortable touch targets, and high-contrast readability.
        </p>
      </div>

      <div class="philosophy-card">
        <h3 class="philosophy-title">Continuous Polish</h3>
        <p class="philosophy-desc">
          Relentless iteration, user ergonomics, and responsible local privacy.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto 72px;
  }

  .philosophy-well {
    background: var(--bg-inset);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-inset-well);
    padding: 36px 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .philosophy-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .philosophy-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-heading);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .philosophy-desc {
    font-size: 0.9rem;
    color: var(--text-body);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 960px) {
    .philosophy-well {
      grid-template-columns: repeat(2, 1fr);
      padding: 28px 24px;
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .section-container {
      margin-bottom: 44px;
    }

    .philosophy-well {
      grid-template-columns: 1fr;
      padding: 20px 16px;
      gap: 16px;
      border-radius: var(--radius-md);
    }

    .philosophy-title {
      font-size: 1rem;
    }

    .philosophy-desc {
      font-size: 0.85rem;
    }
  }
</style>
