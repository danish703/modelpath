---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);
---

<BaseLayout title={app.data.name} description={app.data.tagline}>
  <article>
    <header style="margin-bottom: 2rem;">
      <span style="font-size: 0.875rem; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600;">{app.data.category}</span>
      <h1 style="font-size: 2.25rem; margin: 0.25rem 0 0.5rem;">{app.data.name}</h1>
      <p style="font-size: 1.25rem; color: var(--color-text-secondary);">{app.data.tagline}</p>
      <div style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--color-bg-inset); font-size: 0.875rem; font-weight: 600;">
          Status: {app.data.status}
        </span>
        {app.data.availablePlatforms.map((p) => (
          <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--color-status-published); color: #fff; font-size: 0.875rem; text-transform: capitalize;">
            Available on {p}
          </span>
        ))}
        {app.data.plannedPlatforms.map((p) => (
          <span style="padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--color-bg-inset); font-size: 0.875rem; text-transform: capitalize; color: var(--color-text-muted);">
            Target Platform: {p}
          </span>
        ))}
      </div>
    </header>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Key Features</h2>
      <ul style="margin-left: 1.5rem; color: var(--color-text-secondary); line-height: 1.8;">
        {app.data.features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    </section>

    <section style="margin-bottom: 2rem; color: var(--color-text-secondary); line-height: 1.7;">
      <Content />
    </section>

    <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-subtle); display: flex; gap: 1.5rem;">
      <a href={`/apps/${app.data.slug}/privacy/`}>Privacy Policy</a>
      <a href={`/apps/${app.data.slug}/support/`}>Support &amp; FAQ</a>
      <a href="/apps/">&larr; Back to all apps</a>
    </footer>
  </article>
</BaseLayout>
