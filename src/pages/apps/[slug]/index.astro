---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import PlatformBadge from '../../../components/PlatformBadge.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import ScreenshotPlaceholderCard from '../../../components/ScreenshotPlaceholderCard.astro';
import RelatedAppsSection from '../../../components/RelatedAppsSection.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allApps = await getCollection('apps');
  return allApps.map((app) => ({
    params: { slug: app.data.slug },
    props: {
      app,
      allApps: allApps.map((a) => ({
        slug: a.data.slug,
        name: a.data.name,
        category: a.data.category,
        tagline: a.data.tagline,
        description: a.data.description,
        status: a.data.status,
        availablePlatforms: a.data.availablePlatforms,
        plannedPlatforms: a.data.plannedPlatforms,
      })),
    },
  }));
}

const { app, allApps } = Astro.props;
const { Content } = await render(app);

// SignMint specific rich features matching actual confirmed project scope
const isSignMint = app.data.slug === 'signmint';
const signMintFeatures = [
  {
    title: 'PDF Signature Placement',
    desc: 'Intuitive touch and pen input designed for positioning digital signatures onto PDF pages.',
    icon: 'pen',
  },
  {
    title: 'Document Annotation Tools',
    desc: 'Review and add clear visual annotations, text notes, and markups to documents.',
    icon: 'document',
  },
  {
    title: 'Privacy-Conscious Design',
    desc: 'Engineered to respect document privacy by keeping standard signing workflows transparent and user-directed.',
    icon: 'privacy',
  },
  {
    title: 'Focused Document Workflow',
    desc: 'A straightforward utility experience engineered for practical signing tasks without unnecessary interface clutter.',
    icon: 'performance',
  },
];
---

<BaseLayout
  title={app.data.name}
  description={`${app.data.name} — ${app.data.tagline}. Developed by ModelPath Studio.`}
>
  <article class="detail-container">
    <!-- Product Hero -->
    <header class="product-hero">
      <div class="product-icon-frame">
        {app.data.slug === 'signmint' && (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
        )}
        {app.data.slug === 'ehub' && (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
        )}
        {app.data.slug === 'pylab' && (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5" />
            <line x1="12" y1="19" x2="20" y2="19" />
          </svg>
        )}
        {app.data.slug === 'modelpath-ml' && (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <circle cx="19" cy="6" r="2" />
            <circle cx="5" cy="6" r="2" />
            <circle cx="19" cy="18" r="2" />
            <circle cx="5" cy="18" r="2" />
          </svg>
        )}
        {!['signmint', 'ehub', 'pylab', 'modelpath-ml'].includes(app.data.slug) && (
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          </svg>
        )}
      </div>

      <div class="product-hero-body">
        <div class="hero-meta-row">
          <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/apps/">Applications</a>
            <span aria-hidden="true">/</span>
            <span>{app.data.category}</span>
          </nav>
          <StatusBadge status={app.data.status} size="sm" />
        </div>

        <h1 class="product-name">{app.data.name}</h1>
        <div class="product-headline">{app.data.tagline}</div>
        <p class="product-summary">{app.data.description}</p>

        <div class="product-actions-bar">
          <PlatformBadge
            availablePlatforms={app.data.availablePlatforms}
            plannedPlatforms={app.data.plannedPlatforms}
          />
          <a href="#features" class="action-link-btn">Features</a>
          <a href="#screenshots" class="action-link-btn">Screenshots</a>
          <a href={`/apps/${app.data.slug}/privacy/`} class="action-link-btn">Privacy Policy</a>
          <a href={`/apps/${app.data.slug}/support/`} class="action-link-btn">Support</a>
        </div>
      </div>
    </header>

    <!-- Main Features Section -->
    <section id="features" class="section-wrap">
      <div class="section-header">
        <span class="section-label">Core Capabilities</span>
        <h2 class="section-title">Planned Document Capabilities</h2>
      </div>

      <div class="features-grid">
        {isSignMint
          ? signMintFeatures.map((feat) => (
              <FeatureCard
                title={feat.title}
                description={feat.desc}
                iconType={feat.icon}
              />
            ))
          : app.data.features.map((feat, index) => (
              <FeatureCard
                title={feat}
                description={`${feat} engineered specifically for intuitive workflows in ${app.data.name}.`}
                iconType={index % 2 === 0 ? 'document' : 'performance'}
              />
            ))}
      </div>
    </section>

    <!-- Application Narrative / Content Section -->
    <section class="section-wrap narrative-card">
      <div class="section-header">
        <span class="section-label">Product Overview</span>
        <h2 class="section-title">About {app.data.name}</h2>
      </div>
      <div class="prose-content">
        <Content />
      </div>
    </section>

    <!-- Screenshot Gallery (Clearly Labeled Placeholders) -->
    <section id="screenshots" class="section-wrap">
      <div class="section-header">
        <span class="section-label">Visual Interface</span>
        <h2 class="section-title">Application Screenshots</h2>
      </div>

      <div class="screenshots-grid">
        <ScreenshotPlaceholderCard
          title="Document Viewer & Signature Canvas"
          placeholderNote="[Screenshot Placeholder: Pen input and signature placement]"
          footerLabel="Signature & Document Canvas"
          iconType="canvas"
        />
        <ScreenshotPlaceholderCard
          title="Multi-Page Document Organizer"
          placeholderNote="[Screenshot Placeholder: Multi-page document viewer and page layout]"
          footerLabel="Page Management View"
          iconType="organizer"
        />
        <ScreenshotPlaceholderCard
          title="Signature Profile Presets"
          placeholderNote="[Screenshot Placeholder: Stored signatures, date stamps, and initials]"
          footerLabel="Signature Profiles"
          iconType="profile"
        />
      </div>
    </section>

    <!-- Platform Availability & Pre-Release Download Area -->
    <section class="section-wrap">
      <div class="download-well">
        <div class="download-text-side">
          <h3 class="download-info-title">Platform Availability & Download</h3>
          <p class="download-info-text">
            {app.data.name} is currently in pre-release preparation. Official store links will be published here upon public release verification.
          </p>
        </div>

        <div class="download-cta-side">
          <div class="btn-download-disabled" role="status" aria-label="Store link currently pending release">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            <span>Store Link Pending</span>
          </div>
          <span class="download-status-note">
            Target: {app.data.plannedPlatforms && app.data.plannedPlatforms.length > 0 ? app.data.plannedPlatforms.join(' & ') : 'To be confirmed'} &bull; Coming Soon
          </span>
        </div>
      </div>
    </section>

    <!-- Privacy & Support Capsules -->
    <section class="section-wrap">
      <div class="resources-grid">
        <div class="resource-card">
          <div class="resource-content">
            <h3 class="resource-title">Privacy Policy</h3>
            <p class="resource-desc">
              Review how {app.data.name} handles document security, storage, and telemetry. (Draft for upcoming release).
            </p>
          </div>
          <a href={`/apps/${app.data.slug}/privacy/`} class="action-link-btn">
            View Policy &rarr;
          </a>
        </div>

        <div class="resource-card">
          <div class="resource-content">
            <h3 class="resource-title">Product Support</h3>
            <p class="resource-desc">
              Encountering questions or early feedback? Reach our engineering team directly via email.
            </p>
          </div>
          <a href={`/apps/${app.data.slug}/support/`} class="action-link-btn">
            Get Support &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Related Applications -->
    <RelatedAppsSection currentSlug={app.data.slug} apps={allApps} />
  </article>
</BaseLayout>

<style>
  .detail-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Product Hero */
  .product-hero {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 48px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 56px;
  }

  .product-icon-frame {
    width: 120px;
    height: 120px;
    border-radius: 28px;
    background: var(--bg-raised);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.9);
    flex-shrink: 0;
  }

  .product-icon-frame svg {
    width: 58px;
    height: 58px;
    stroke: var(--accent-blue);
  }

  .product-hero-body {
    display: flex;
    flex-direction: column;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent-blue);
  }

  .product-name {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 8px 0;
  }

  .product-headline {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-blue);
    margin-bottom: 12px;
  }

  .product-summary {
    font-size: 1.05rem;
    color: var(--text-body);
    line-height: 1.6;
    max-width: 780px;
    margin: 0 0 24px 0;
  }

  .product-actions-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .action-link-btn {
    background: var(--bg-raised);
    color: var(--text-heading);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .action-link-btn:hover {
    color: var(--accent-blue);
    transform: translateY(-1px);
    box-shadow: -4px -4px 10px #FFFFFF, 4px 5px 14px rgba(169, 180, 196, 0.32);
  }

  /* Section Common */
  .section-wrap {
    margin-bottom: 56px;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 6px;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Narrative Card */
  .narrative-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  .prose-content {
    font-size: 1.05rem;
    color: var(--text-body);
    line-height: 1.7;
  }

  /* Screenshots Grid */
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Pre-Release Download Well */
  .download-well {
    background: var(--bg-inset);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-inset-well);
    padding: 36px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .download-text-side {
    max-width: 600px;
  }

  .download-info-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-heading);
    margin: 0 0 8px 0;
  }

  .download-info-text {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.6;
    margin: 0;
  }

  .download-cta-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-download-disabled {
    background: var(--bg-raised);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn-secondary);
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: default;
    user-select: none;
  }

  .btn-download-disabled svg {
    width: 18px;
    height: 18px;
  }

  .download-status-note {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Resources Capsules */
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .resource-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .resource-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .resource-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
  }

  .resource-desc {
    font-size: 0.9rem;
    color: var(--text-body);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 860px) {
    .product-hero {
      grid-template-columns: 1fr;
      padding: 24px 18px;
      gap: 18px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
      margin-bottom: 36px;
    }

    .product-icon-frame {
      width: 64px;
      height: 64px;
      border-radius: 16px;
    }

    .product-icon-frame svg {
      width: 32px;
      height: 32px;
    }

    .product-headline {
      font-size: 1rem;
    }

    .product-summary {
      font-size: 0.875rem;
      margin-bottom: 16px;
    }

    .section-wrap {
      margin-bottom: 36px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .narrative-card {
      padding: 20px 16px;
      border-radius: var(--radius-md);
    }

    .screenshots-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .download-well {
      flex-direction: column;
      padding: 24px 18px;
      gap: 18px;
      border-radius: var(--radius-md);
    }

    .download-info-title {
      font-size: 1.15rem;
    }

    .download-info-text {
      font-size: 0.85rem;
    }

    .download-cta-side {
      width: 100%;
      align-items: center;
    }

    .btn-download-disabled {
      width: 100%;
      justify-content: center;
      font-size: 0.875rem;
      padding: 12px;
    }

    .resources-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .resource-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 16px;
      border-radius: var(--radius-md);
    }
  }
</style>
