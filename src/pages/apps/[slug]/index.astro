---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import RelatedAppsSection from '../../../components/RelatedAppsSection.astro';
import AppIcon from '../../../components/AppIcon.astro';
import AppCover from '../../../components/AppCover.astro';
import ScreenshotCarousel from '../../../components/ScreenshotCarousel.astro';
import PlatformDownloads from '../../../components/PlatformDownloads.astro';
import { getCollection, render } from 'astro:content';
import {
  getPlatformAvailability,
  getScreenshotSlides,
  resolveCover,
  resolveIcon,
  resolveVideo,
  toCardModel,
} from '../../../lib/appMedia';

export async function getStaticPaths() {
  const allApps = await getCollection('apps');
  const sorted = [...allApps].sort((a, b) => a.data.order - b.data.order);
  return allApps.map((app) => ({
    params: { slug: app.data.slug },
    props: {
      app,
      allApps: sorted.map((a) => toCardModel(a.data)),
    },
  }));
}

const { app, allApps } = Astro.props;
const { Content } = await render(app);
const data = app.data;

// Parse features dynamically
interface FeatureItem {
  title: string;
  description: string;
  icon?: string;
  status?: 'available' | 'planned' | 'verification-pending';
}

const featuresList: FeatureItem[] = (data.features || []).map((f) => {
  if (typeof f === 'string') {
    return {
      title: f,
      description: `${f} engineered for ${data.name}.`,
      icon: 'document',
      status: 'available',
    };
  }
  return {
    title: f.title,
    description: f.description,
    icon: f.icon || 'document',
    status: f.status || 'available',
  };
});

// Gate 11/12 media
const icon = resolveIcon(data);
const cover = resolveCover(data);
const video = resolveVideo(data);
const slides = getScreenshotSlides(data);
const hasGenuineScreens = slides.some((s) => s.kind === 'genuine');
const platforms = getPlatformAvailability(data);
const anyStoreEnabled = platforms.some((p) => p.enabled);

const isEligiblePublished =
  data.status === 'published' &&
  data.availablePlatforms.length > 0;

const pageSchema: Record<string, unknown> = isEligiblePublished
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: data.name,
      description: data.description,
      applicationCategory: data.category,
      operatingSystem: data.availablePlatforms.join(', '),
      url: `https://modelpath.app/apps/${data.slug}/`,
      ...(icon ? { image: `https://modelpath.app${icon.src}` } : {}),
      author: {
        '@id': 'https://modelpath.app/#organization',
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: `${data.name} — ${data.tagline}`,
      description: `${data.name} by ModelPath Studio: ${data.description}`,
      url: `https://modelpath.app/apps/${data.slug}/`,
      isPartOf: {
        '@id': 'https://modelpath.app/#website',
      },
    };

// Platform helper tags for hero staging
const androidStaging = data.availablePlatforms?.includes('android')
  ? 'Android • Live'
  : data.plannedPlatforms?.includes('android')
  ? 'Android • Coming Soon'
  : 'Android • Not Planned';

const iosStaging = data.availablePlatforms?.includes('ios')
  ? 'iOS • Live'
  : data.plannedPlatforms?.includes('ios')
  ? 'iOS • In Development'
  : 'iOS • Not Currently Planned';
---

<BaseLayout
  title={`${data.name} — ${data.tagline}`}
  description={`${data.name} by ModelPath Studio: ${data.description}`}
  ogImage={cover?.src ?? icon?.src}
  jsonLd={pageSchema}
>
  <div class="app-detail-page">
    <!-- Product Hero (Dark Atmospheric Midnight Navy Split-Layout) -->
    <header class="product-hero">
      <div class="container hero-container">
        <div class="hero-split-grid">
          <!-- Left Column: Identity & Meta -->
          <div class="hero-left-column">
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span aria-hidden="true">&rsaquo;</span>
              <a href="/apps/">Applications</a>
              <span aria-hidden="true">&rsaquo;</span>
              <span class="current">{data.name}</span>
            </nav>

            <div class="hero-meta-row">
              <div class="app-icon-capsule">
                <AppIcon slug={data.slug} name={data.name} icon={icon} size="md" decorative={false} />
              </div>
              <div class="hero-title-group">
                <span class="category-chip">{data.category}</span>
                <StatusBadge status={data.status} size="sm" />
              </div>
            </div>

            <h1 class="app-main-title">{data.name}</h1>
            <p class="hero-subtitle">{data.tagline || data.description}</p>

            <div class="hero-platform-staging">
              <span class:list={['platform-pill-staging', { 'not-planned': !data.plannedPlatforms?.includes('android') && !data.availablePlatforms?.includes('android') }]}>
                {androidStaging}
              </span>
              <span class:list={['platform-pill-staging', { 'not-planned': !data.plannedPlatforms?.includes('ios') && !data.availablePlatforms?.includes('ios') }]}>
                {iosStaging}
              </span>
            </div>

            <div class="hero-anchor-pills">
              <a href="#screenshots" class="anchor-pill primary-pill">Screenshots</a>
              <a href="#features" class="anchor-pill">Capabilities</a>
              <a href="#download" class="anchor-pill">Store Access</a>
              <a href={`/apps/${data.slug}/privacy/`} class="anchor-pill">
                {data.privacyPolicyStatus === 'verified' ? 'Privacy Policy' : 'Privacy (Draft)'}
              </a>
              <a href={`/apps/${data.slug}/support/`} class="anchor-pill">Support</a>
            </div>
          </div>

          <!-- Right Column: Conceptual Artwork Frame -->
          <div class="hero-right-column">
            <div class="hero-illustration-frame">
              <div class="illustration-window-bar">
                <div class="window-dots" aria-hidden="true">
                  <span class="window-dot" style="background: #EF4444;"></span>
                  <span class="window-dot" style="background: #F59E0B;"></span>
                  <span class="window-dot" style="background: #10B981;"></span>
                </div>
                <span class="window-filename">{data.slug}-blueprint.v1</span>
                <span class="window-status-chip">OFFLINE SPEC</span>
              </div>

              <div class="illustration-canvas">
                <AppCover slug={data.slug} name={data.name} cover={cover} variant="hero" eager />
              </div>

              <div class="illustration-footer-tag">
                <span>[{data.name}] &bull; Conceptual Preview</span>
                <span>{data.status === 'published' ? 'Status: Production Release' : 'Status: Pre-Release Blueprint'}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content on Light Editorial Canvas -->
    <main class="editorial-canvas">
      <div class="container">
        <!-- Visual Interface / Conceptual Media Showcase -->
        <section id="screenshots" class="detail-section" aria-labelledby="screenshots-heading">
          <div class="section-heading-block">
            <span class="section-eyebrow">VISUAL INTERFACE</span>
            <h2 class="section-title" id="screenshots-heading">Conceptual Media Showcase</h2>
            <p class="section-subtitle">
              {hasGenuineScreens
                ? `Official interface captures from ${data.name}.`
                : `Visual design blueprints and interface concepts for ${data.name}. Authentic production screenshots will be published upon release.`}
            </p>
          </div>

          <ScreenshotCarousel appName={data.name} slides={slides} id={`${data.slug}-screenshots`} />
        </section>

        <!-- Optional verified demonstration video -->
        {video && (
          <section id="demo" class="detail-section" aria-labelledby="demo-heading">
            <div class="section-heading-block">
              <span class="section-eyebrow">IN MOTION</span>
              <h2 class="section-title" id="demo-heading">{video.title}</h2>
            </div>
            <div class="video-card">
              <video
                class="demo-video"
                controls
                playsinline
                preload="none"
                poster={video.poster}
                aria-describedby="demo-description"
              >
                <source src={video.src} type={video.type} />
                Your browser does not support embedded video. <a href={video.src}>Download the demonstration video</a>.
              </video>
              <p id="demo-description" class="video-desc">{video.description}</p>
            </div>
          </section>
        )}

        <!-- Core Capabilities Section -->
        <section id="features" class="detail-section" aria-labelledby="features-heading">
          <div class="section-heading-block">
            <span class="section-eyebrow">CORE CAPABILITIES</span>
            <h2 class="section-title" id="features-heading">Engineered for Performance</h2>
            <p class="section-subtitle">
              Key architectural capabilities designed for offline reliability, performance, and respectful user privacy.
            </p>
          </div>

          <div class="features-grid">
            {featuresList.map((feat) => (
              <FeatureCard
                title={feat.title}
                description={feat.description}
                iconType={feat.icon}
                status={feat.status}
              />
            ))}
          </div>
        </section>

        <!-- Application Narrative / Content Section -->
        <section id="about" class="detail-section" aria-labelledby="about-heading">
          <div class="section-heading-block">
            <span class="section-eyebrow">PRODUCT OVERVIEW</span>
            <h2 class="section-title" id="about-heading">About {data.name}</h2>
          </div>
          <div class="narrative-card">
            <div class="prose-content">
              <Content />
            </div>
          </div>
        </section>

        <!-- Platform Availability & Download -->
        <section id="download" class="detail-section" aria-labelledby="download-heading">
          <div class="section-heading-block">
            <span class="section-eyebrow">DISTRIBUTION</span>
            <h2 class="section-title" id="download-heading">Platform Availability &amp; Store Access</h2>
            <p class="section-subtitle">
              {anyStoreEnabled
                ? `Official store listings for ${data.name}. Direct download controls connect to verified platform listings.`
                : `${data.name} is currently in pre-release development. Public store controls activate immediately upon live store listing.`}
            </p>
          </div>
          <PlatformDownloads appName={data.name} platforms={platforms} />
        </section>

        <!-- Privacy & Support Capsules -->
        <section class="detail-section" aria-label="Privacy and support resources">
          <div class="resources-grid">
            <div class="resource-card">
              <div class="resource-content">
                <span class="resource-tag">SECURITY &amp; COMPLIANCE</span>
                <h3 class="resource-title">
                  {data.privacyPolicyStatus === 'verified' ? 'Privacy Policy' : 'Privacy Disclosures (Draft)'}
                </h3>
                <p class="resource-desc">
                  {data.privacyPolicyStatus === 'verified'
                    ? `Review verified data practices, security disclosures, and user rights for ${data.name}.`
                    : `Review pre-release privacy disclosures and data handling specifications for ${data.name} (compliance review pending).`}
                </p>
              </div>
              <a href={`/apps/${data.slug}/privacy/`} class="resource-action-btn">
                {data.privacyPolicyStatus === 'verified' ? 'View Policy \u2192' : 'View Draft Disclosures \u2192'}
              </a>
            </div>

            <div class="resource-card">
              <div class="resource-content">
                <span class="resource-tag">DIRECT ASSISTANCE</span>
                <h3 class="resource-title">Product Support &amp; Feedback</h3>
                <p class="resource-desc">
                  Encountering questions, bugs, or early feedback? Reach our engineering team directly via verified support channels.
                </p>
              </div>
              <a href={`/apps/${data.slug}/support/`} class="resource-action-btn">
                Get Support &rarr;
              </a>
            </div>
          </div>
        </section>

        <!-- Related Applications -->
        <RelatedAppsSection currentSlug={data.slug} apps={allApps} />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .app-detail-page {
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Product Hero (Dark Atmospheric Midnight Navy Split-Layout) */
  .product-hero {
    padding-top: 64px;
    padding-bottom: 72px;
    background: radial-gradient(circle at 65% 25%, rgba(79, 107, 255, 0.18) 0%, rgba(139, 92, 246, 0.09) 45%, transparent 72%), var(--c-midnight, #0B1225);
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--c-text-light-muted, #94A3B8);
    margin-bottom: 20px;
  }

  .breadcrumbs a {
    color: var(--c-text-light-muted, #94A3B8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumbs a:hover {
    color: #FFFFFF;
  }

  .breadcrumbs span.current {
    color: var(--c-cyan, #73DDE6);
    font-weight: 600;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .app-icon-capsule {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: linear-gradient(135deg, #172441, #0B1225);
    border: 2px solid rgba(79, 107, 255, 0.35);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .category-chip {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cyan, #73DDE6);
  }

  .app-main-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(2.4rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 14px 0;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--c-text-light-muted, #94A3B8);
    line-height: 1.6;
    margin: 0 0 22px 0;
    max-width: 580px;
  }

  .hero-platform-staging {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .platform-pill-staging {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-pill, 9999px);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(79, 107, 255, 0.12);
    color: #93C5FD;
    border: 1px solid rgba(79, 107, 255, 0.28);
  }

  .platform-pill-staging.not-planned {
    background: rgba(255, 255, 255, 0.05);
    color: #94A3B8;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .hero-anchor-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .anchor-pill {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(23, 36, 65, 0.85);
    color: var(--c-text-light, #F8FAFC);
    border: 1px solid rgba(79, 107, 255, 0.25);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .anchor-pill:hover {
    background: var(--c-cobalt, #4F6BFF);
    border-color: var(--c-cobalt, #4F6BFF);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .anchor-pill.primary-pill {
    background: var(--c-cobalt, #4F6BFF);
    border-color: var(--c-cobalt, #4F6BFF);
    box-shadow: 0 4px 14px rgba(79, 107, 255, 0.35);
  }

  /* Hero Right Column: Conceptual Artwork Frame */
  .hero-illustration-frame {
    background: linear-gradient(145deg, rgba(23, 36, 65, 0.9), rgba(11, 18, 37, 0.95));
    border: 1px solid rgba(79, 107, 255, 0.3);
    border-radius: var(--radius-card, 20px);
    padding: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .illustration-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(79, 107, 255, 0.15);
    padding-bottom: 12px;
    margin-bottom: 18px;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .window-filename {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: var(--c-text-light-muted, #94A3B8);
  }

  .window-status-chip {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(115, 221, 230, 0.12);
    color: var(--c-cyan, #73DDE6);
    border: 1px solid rgba(115, 221, 230, 0.25);
  }

  .illustration-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
  }

  .illustration-footer-tag {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(79, 107, 255, 0.15);
    font-size: 0.76rem;
    color: var(--c-cyan, #73DDE6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
  }

  /* Light Editorial Canvas */
  .editorial-canvas {
    background: var(--c-offwhite, #F8FAFC);
    color: var(--c-text-dark, #0F172A);
    padding: 72px 0 88px;
  }

  .detail-section {
    margin-bottom: 64px;
    scroll-margin-top: 96px;
  }

  .section-heading-block {
    margin-bottom: 28px;
  }

  .section-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 8px;
  }

  .section-title {
    font-family: var(--font-display, inherit);
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 10px 0;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-dark-muted, #475569);
    max-width: 680px;
    margin: 0;
    line-height: 1.6;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Narrative Card */
  .narrative-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 36px;
    border: 1px solid rgba(203, 213, 225, 0.6);
  }

  .prose-content {
    font-size: 1.025rem;
    color: var(--c-text-dark, #0F172A);
    line-height: 1.7;
  }

  .prose-content :global(h2),
  .prose-content :global(h3) {
    font-family: var(--font-display, inherit);
    color: var(--c-text-dark, #0F172A);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose-content :global(p) {
    margin-bottom: 1em;
    color: var(--c-text-dark-muted, #475569);
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1em;
    color: var(--c-text-dark-muted, #475569);
  }

  /* Video demo */
  .video-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    border: 1px solid rgba(203, 213, 225, 0.6);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 20px;
  }

  .demo-video {
    display: block;
    width: 100%;
    max-height: 600px;
    border-radius: 12px;
    background: #0B1225;
  }

  .video-desc {
    font-size: 0.9rem;
    color: var(--c-text-dark-muted, #475569);
    margin: 14px 4px 4px;
  }

  /* Resources Capsules */
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .resource-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 32px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .resource-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .resource-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cobalt, #4F6BFF);
    font-family: var(--font-mono, monospace);
  }

  .resource-title {
    font-family: var(--font-display, inherit);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0;
  }

  .resource-desc {
    font-size: 0.92rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.55;
    margin: 0;
  }

  .resource-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: var(--radius-pill, 9999px);
    background: var(--c-cobalt, #4F6BFF);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    width: fit-content;
    box-shadow: 0 4px 12px rgba(79, 107, 255, 0.3);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .resource-action-btn:hover {
    background: var(--c-cobalt-hover, #3D58E6);
    transform: translateY(-1px);
  }

  /* Responsive Rules */
  @media (max-width: 960px) {
    .hero-split-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .resources-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 20px;
    }

    .product-hero {
      padding-top: 40px;
      padding-bottom: 48px;
    }

    .breadcrumbs {
      font-size: 0.875rem;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .app-icon-capsule {
      width: 60px;
      height: 60px;
      border-radius: 16px;
