---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import PlatformBadge from '../../../components/PlatformBadge.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import RelatedAppsSection from '../../../components/RelatedAppsSection.astro';
import AppIcon from '../../../components/AppIcon.astro';
import AppCover from '../../../components/AppCover.astro';
import ScreenshotCarousel from '../../../components/ScreenshotCarousel.astro';
import PlatformDownloads from '../../../components/PlatformDownloads.astro';
import { getCollection, render } from 'astro:content';
import {
  getPlatformAvailability,
  getScreenshotSlides,
  resolveCover,
  resolveIcon,
  resolveVideo,
  toCardModel,
} from '../../../lib/appMedia';

export async function getStaticPaths() {
  const allApps = await getCollection('apps');
  const sorted = [...allApps].sort((a, b) => a.data.order - b.data.order);
  return allApps.map((app) => ({
    params: { slug: app.data.slug },
    props: {
      app,
      allApps: sorted.map((a) => toCardModel(a.data)),
    },
  }));
}

const { app, allApps } = Astro.props;
const { Content } = await render(app);
const data = app.data;

// Parse features dynamically
interface FeatureItem {
  title: string;
  description: string;
  icon?: string;
  status?: 'available' | 'planned' | 'verification-pending';
}

const featuresList: FeatureItem[] = (data.features || []).map((f) => {
  if (typeof f === 'string') {
    return {
      title: f,
      description: `${f} engineered for ${data.name}.`,
      icon: 'document',
      status: 'available',
    };
  }
  return {
    title: f.title,
    description: f.description,
    icon: f.icon || 'document',
    status: f.status || 'available',
  };
});

// Gate 11 media (genuine assets or honest placeholders)
const icon = resolveIcon(data);
const cover = resolveCover(data);
const video = resolveVideo(data);
const slides = getScreenshotSlides(data);
const hasGenuineScreens = slides.some((s) => s.kind === 'genuine');
const platforms = getPlatformAvailability(data);
const anyStoreEnabled = platforms.some((p) => p.enabled);

const isEligiblePublished =
  data.status === 'published' &&
  data.availablePlatforms.length > 0;

const pageSchema: Record<string, unknown> = isEligiblePublished
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: data.name,
      description: data.description,
      applicationCategory: data.category,
      operatingSystem: data.availablePlatforms.join(', '),
      url: `https://modelpath.app/apps/${data.slug}/`,
      ...(icon ? { image: `https://modelpath.app${icon.src}` } : {}),
      author: {
        '@id': 'https://modelpath.app/#organization',
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: `${data.name} — ${data.tagline}`,
      description: `${data.name} by ModelPath Studio: ${data.description}`,
      url: `https://modelpath.app/apps/${data.slug}/`,
      isPartOf: {
        '@id': 'https://modelpath.app/#website',
      },
    };
---

<BaseLayout
  title={`${data.name} — ${data.tagline}`}
  description={`${data.name} by ModelPath Studio: ${data.description}`}
  ogImage={cover?.src ?? icon?.src}
  jsonLd={pageSchema}
>
  <article class="detail-container">
    <!-- Product Hero -->
    <header class="product-hero">
      <div class="product-hero-body">
        <div class="hero-identity">
          <AppIcon slug={data.slug} name={data.name} icon={icon} size="lg" decorative={false} class="hero-app-icon" />
          <div class="hero-meta-row">
            <nav class="breadcrumb-nav" aria-label="Breadcrumb">
              <a href="/apps/">Applications</a>
              <span aria-hidden="true">/</span>
              <span>{data.category}</span>
            </nav>
            <StatusBadge status={data.status} size="sm" />
          </div>
        </div>

        <h1 class="product-name">{data.name}</h1>
        <div class="product-headline">{data.tagline}</div>
        <p class="product-summary">{data.description}</p>

        <div class="product-actions-bar">
          <PlatformBadge
            availablePlatforms={data.availablePlatforms}
            plannedPlatforms={data.plannedPlatforms}
          />
          <a href="#screenshots" class="action-link-btn">Screenshots</a>
          <a href="#features" class="action-link-btn">Features</a>
          <a href="#download" class="action-link-btn">Download</a>
          <a href={`/apps/${data.slug}/privacy/`} class="action-link-btn">
            {data.privacyPolicyStatus === 'verified' ? 'Privacy Policy' : 'Privacy (Draft)'}
          </a>
          <a href={`/apps/${data.slug}/support/`} class="action-link-btn">Support</a>
        </div>
      </div>

      <div class="product-hero-media">
        <AppCover slug={data.slug} name={data.name} cover={cover} variant="hero" eager />
      </div>
    </header>

    <!-- Screenshot Carousel (genuine images or clearly labelled placeholders) -->
    <section id="screenshots" class="section-wrap" aria-labelledby="screenshots-heading" data-reveal>
      <div class="section-header">
        <span class="section-label">Visual Interface</span>
        <h2 class="section-title" id="screenshots-heading">Application Screenshots</h2>
        {!hasGenuineScreens && (
          <p class="section-note">
            Authentic screenshots of {data.name} have not been published yet. The panels below are labelled placeholders, not product imagery.
          </p>
        )}
      </div>
      <ScreenshotCarousel appName={data.name} slides={slides} id={`${data.slug}-screenshots`} />
    </section>

    <!-- Optional verified demonstration video (rendered only when genuinely supplied) -->
    {video && (
      <section id="demo" class="section-wrap" aria-labelledby="demo-heading" data-reveal>
        <div class="section-header">
          <span class="section-label">In Motion</span>
          <h2 class="section-title" id="demo-heading">{video.title}</h2>
        </div>
        <div class="video-card">
          <video
            class="demo-video"
            controls
            playsinline
            preload="none"
            poster={video.poster}
            aria-describedby="demo-description"
          >
            <source src={video.src} type={video.type} />
            Your browser does not support embedded video. <a href={video.src}>Download the demonstration video</a>.
          </video>
          <p id="demo-description" class="video-desc">{video.description}</p>
        </div>
      </section>
    )}

    <!-- Main Features Section -->
    <section id="features" class="section-wrap" aria-labelledby="features-heading">
      <div class="section-header" data-reveal>
        <span class="section-label">Core Capabilities</span>
        <h2 class="section-title" id="features-heading">Application Capabilities &amp; Features</h2>
      </div>

      <div class="features-grid">
        {featuresList.map((feat) => (
          <FeatureCard
            title={feat.title}
            description={feat.description}
            iconType={feat.icon}
            status={feat.status}
          />
        ))}
      </div>
    </section>

    <!-- Application Narrative / Content Section -->
    <section class="section-wrap narrative-card" aria-labelledby="about-heading" data-reveal>
      <div class="section-header">
        <span class="section-label">Product Overview</span>
        <h2 class="section-title" id="about-heading">About {data.name}</h2>
      </div>
      <div class="prose-content">
        <Content />
      </div>
    </section>

    <!-- Platform Availability & Download -->
    <section id="download" class="section-wrap" aria-labelledby="download-heading">
      <div class="section-header" data-reveal>
        <span class="section-label">Platform Availability</span>
        <h2 class="section-title" id="download-heading">Download {data.name}</h2>
        <p class="section-note">
          {anyStoreEnabled
            ? `Official store listings for ${data.name}. Links open the verified store page in a new tab.`
            : `${data.name} has no public store listing yet. Store buttons activate only once a verified listing is live.`}
        </p>
      </div>
      <PlatformDownloads appName={data.name} platforms={platforms} />
    </section>

    <!-- Privacy & Support Capsules -->
    <section class="section-wrap" aria-label="Privacy and support">
      <div class="resources-grid">
        <div class="resource-card" data-reveal>
          <div class="resource-content">
            <h3 class="resource-title">
              {data.privacyPolicyStatus === 'verified' ? 'Privacy Policy' : 'Privacy Disclosures (Draft)'}
            </h3>
            <p class="resource-desc">
              {data.privacyPolicyStatus === 'verified'
                ? `Review data practices, security disclosures, and user rights for ${data.name}.`
                : `Review pre-release privacy disclosures and data handling specifications for ${data.name} (compliance review pending).`}
            </p>
          </div>
          <a href={`/apps/${data.slug}/privacy/`} class="action-link-btn">
            {data.privacyPolicyStatus === 'verified' ? 'View Policy \u2192' : 'View Draft Disclosures \u2192'}
          </a>
        </div>

        <div class="resource-card" data-reveal>
          <div class="resource-content">
            <h3 class="resource-title">Product Support</h3>
            <p class="resource-desc">
              Encountering questions or early feedback? Reach our engineering team directly via email.
            </p>
          </div>
          <a href={`/apps/${data.slug}/support/`} class="action-link-btn">
            Get Support &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Related Applications -->
    <RelatedAppsSection currentSlug={data.slug} apps={allApps} />
  </article>
</BaseLayout>

<style>
  .detail-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Product Hero */
  .product-hero {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 40px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    gap: 40px;
    align-items: center;
    margin-bottom: 56px;
    animation: detail-rise 640ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes detail-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .product-hero-body {
    display: flex;
    flex-direction: column;
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent-blue);
  }

  .product-name {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 8px 0;
  }

  .product-headline {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-blue);
    margin-bottom: 12px;
  }

  .product-summary {
    font-size: 1.05rem;
    color: var(--text-body);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 0 24px 0;
  }

  .product-actions-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .action-link-btn {
    background: var(--bg-raised);
    color: var(--text-heading);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .action-link-btn:hover {
    color: var(--accent-blue);
    transform: translateY(-1px);
    box-shadow: -4px -4px 10px #FFFFFF, 4px 5px 14px rgba(169, 180, 196, 0.32);
  }

  .action-link-btn:active {
    transform: translateY(0) scale(0.98);
    box-shadow: var(--shadow-inset-box);
  }

  /* Section Common */
  .section-wrap {
    margin-bottom: 56px;
    scroll-margin-top: 24px;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 6px;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-note {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 8px 0 0;
    max-width: 720px;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Narrative Card */
  .narrative-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  .prose-content {
    font-size: 1.05rem;
    color: var(--text-body);
    line-height: 1.7;
  }

  /* Demo video */
  .video-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(255, 255, 255, 0.85);
    padding: 16px;
  }

  .demo-video {
    display: block;
    width: 100%;
    max-height: 640px;
    border-radius: var(--radius-md);
    background: var(--bg-inset);
  }

  .video-desc {
    font-size: 0.9rem;
    color: var(--text-body);
    margin: 12px 4px 4px;
  }

  /* Resources Capsules */
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .resource-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .resource-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .resource-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
  }

  .resource-desc {
    font-size: 0.9rem;
    color: var(--text-body);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 960px) {
    .product-hero {
      grid-template-columns: 1fr;
    }

    .product-hero-media {
      max-width: 520px;
    }
  }

  @media (max-width: 860px) {
    .product-hero {
      padding: 22px 16px;
      gap: 22px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card-mobile);
      margin-bottom: 36px;
    }

    .hero-identity {
      gap: 12px;
      margin-bottom: 14px;
    }

    .product-headline {
      font-size: 1rem;
    }

    .product-summary {
      font-size: 0.875rem;
      margin-bottom: 16px;
    }

    .product-actions-bar {
      gap: 10px;
    }

    .action-link-btn {
      font-size: 0.8125rem;
      padding: 8px 14px;
    }

    .section-wrap {
      margin-bottom: 36px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .narrative-card {
      padding: 20px 16px;
      border-radius: var(--radius-md);
    }

    .resources-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .resource-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 16px;
      border-radius: var(--radius-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-hero {
      animation: none;
    }

    .action-link-btn:hover,
    .action-link-btn:active {
      transform: none;
    }
  }
</style>
