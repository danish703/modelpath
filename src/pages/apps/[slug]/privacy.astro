---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { appPrivacyChecklists } from '../../../data/appPrivacyChecklist';
import { studioContactConfig } from '../../../data/studioContact';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const isVerified = app.data.privacyPolicyStatus === 'verified';
const isPending = app.data.privacyPolicyStatus === 'pending-review';
const isDraft = app.data.privacyPolicyStatus === 'draft';
const privacyEmail = studioContactConfig.emails.privacy || app.data.supportEmail;

const evidenceProfile = appPrivacyChecklists[app.data.slug] || {
  appName: app.data.name,
  slug: app.data.slug,
  currentPolicyStatus: app.data.privacyPolicyStatus,
  summary: 'Pre-release application currently undergoing compliance review.',
  checklist: []
};

const disclosures = app.data.privacyDisclosures || {
  dataCollection: [],
  dataUsage: [],
  storageAndRetention: '',
  sharingAndThirdParties: [],
  advertising: '',
  analytics: '',
  permissions: [],
  securityPractices: '',
  dataDeletion: '',
  contactEmail: privacyEmail
};
---

<BaseLayout
  title={`${app.data.name} Privacy Disclosures`}
  description={`Privacy practices, data handling disclosures, and compliance review status for ${app.data.name} by ModelPath Studio.`}
  noindex={!isVerified}
>
  <div class="app-privacy-page">
    <!-- Dark Atmospheric Header -->
    <header class="app-privacy-hero">
      <div class="container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb-bar" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/apps/">Applications</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href={`/apps/${app.data.slug}/`}>{app.data.name}</a>
          <span aria-hidden="true">&rsaquo;</span>
          <span class="current">Privacy</span>
        </nav>

        <div class="header-main-row">
          <div class="app-icon-frame" aria-hidden="true">
            {app.data.slug === 'signmint' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
              </svg>
            )}
            {app.data.slug === 'ehub' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </svg>
            )}
            {app.data.slug === 'pylab' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
            )}
            {app.data.slug === 'modelpath-ml' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <circle cx="19" cy="6" r="2" />
                <circle cx="5" cy="6" r="2" />
                <circle cx="19" cy="18" r="2" />
                <circle cx="5" cy="18" r="2" />
              </svg>
            )}
          </div>
          <div class="header-titles">
            <div class="header-status-row">
              <span class="app-cat-label">{app.data.category}</span>
              <span class={`status-pill pill-${app.data.privacyPolicyStatus}`}>
                {isVerified ? 'Policy Verified' : isPending ? 'Pending Legal Audit' : isDraft ? 'Draft Policy' : 'Unverified'}
              </span>
            </div>
            <h1 class="policy-main-title">Privacy Policy — {app.data.name}</h1>
            <p class="policy-meta-line">
              {isVerified ? (
                <span>Effective: {app.data.privacyPolicyEffectiveDate || 'Verified'} &bull; Last Updated: {app.data.privacyPolicyLastUpdated || 'Verified'}</span>
              ) : (
                <span>Pre-Release Application &bull; Status: Legal Verification In Progress</span>
              )}
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Editorial Canvas Section -->
    <main class="editorial-canvas">
      <div class="container policy-body-container">
        {!isVerified ? (
          <div class="unverified-state-wrapper">
            <section class="unverified-banner-card" aria-labelledby="banner-heading">
              <div class="banner-icon-well" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
              </div>
              <div class="banner-body">
                <span class="banner-eyebrow">Pre-Release Status Notice</span>
                <h2 id="banner-heading" class="banner-title">Privacy Policy Not Yet Published</h2>
                <p class="banner-desc">
                  <strong>{app.data.name}</strong> is currently in pre-release development. A finalized, legally binding public privacy policy has not yet been audited or published for this application.
                </p>
                <div class="readiness-lock-well">
                  <strong class="lock-title">Production Readiness Safeguard</strong>
                  <p class="lock-text">
                    Under ModelPath Studio publication safeguards, no application may be released to public app distribution channels until its complete data governance audit is signed off and this policy is transitioned to Verified status.
                  </p>
                </div>
              </div>
            </section>

            <section class="evidence-checklist-card" aria-labelledby="checklist-heading">
              <div class="card-header">
                <span class="card-label">Empirical Codebase Audit</span>
                <h2 id="checklist-heading" class="card-title">Pre-Release Technical Findings</h2>
                <p class="card-subtext">
                  The following table records verified technical facts and pending audit items identified from accessible repository configurations for {app.data.name}:
                </p>
              </div>

              <div class="checklist-items">
                {evidenceProfile.checklist.map((item: any) => (
                  <div class="checklist-row">
                    <div class="checklist-main">
                      <span class="checklist-category">{item.category}</span>
                      <h3 class="checklist-name">{item.item}</h3>
                      <p class="checklist-detail">{item.finding}</p>
                    </div>
                    <div class="checklist-badge-col">
                      <span class={`status-chip chip-${item.status}`}>
                        {item.status === 'confirmed' ? 'Audit Verified' : item.status === 'planned' ? 'Planned Spec' : 'Unconfirmed'}
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <div class="evidence-footnote">
                <p>
                  * Findings derived solely from inspected codebase trees and application manifests. No marketing assertions have been included without empirical verification.
                </p>
              </div>
            </section>
          </div>
        ) : (
          <div class="verified-document-card">
            <div class="policy-block">
              <h2>1. Overview and Core Scope</h2>
              <p>
                This Privacy Policy applies specifically to the mobile application <strong>{app.data.name}</strong> developed and published by ModelPath Studio. We are committed to transparency regarding how data is processed, stored, and protected during your use of our software.
              </p>
            </div>

            <div class="policy-block">
              <h2>2. Information Collection and Processing</h2>
              <p>
                ModelPath Studio adheres to strict data minimization principles. Below is an exhaustive description of data categories associated with {app.data.name}:
              </p>
              <ul>
                {disclosures.dataCollection && disclosures.dataCollection.length > 0 ? (
                  disclosures.dataCollection.map((item: string) => <li>{item}</li>)
                ) : (
                  <li>No personal identifying information is collected, processed, or logged by default.</li>
                )}
              </ul>
            </div>

            <div class="policy-block">
              <h2>3. Purpose and Utilization of Data</h2>
              <ul>
                {disclosures.dataUsage && disclosures.dataUsage.length > 0 ? (
                  disclosures.dataUsage.map((item: string) => <li>{item}</li>)
                ) : (
                  <li>Local application functionality, offline document manipulation, and device-bound feature state preservation.</li>
                )}
              </ul>
            </div>

            <div class="policy-block">
              <h2>4. Storage, Retention, and Offline Processing</h2>
              <p>
                {disclosures.storageAndRetention ||
                  `${app.data.name} processes data entirely on your device local storage. We maintain no cloud database, user accounts, or external storage mechanisms for your content.`}
              </p>
            </div>

            <div class="policy-block">
              <h2>5. Third-Party Services and Analytics</h2>
              <p>
                {disclosures.analytics || 'No third-party tracking, profiling, or analytical SDKs are integrated into this release build.'}
              </p>
              <p>
                {disclosures.advertising || 'No third-party behavioral advertising networks operate within this application.'}
              </p>
            </div>

            <div class="policy-block">
              <h2>6. Device Permissions Requested</h2>
              <ul>
                {disclosures.permissions && disclosures.permissions.length > 0 ? (
                  disclosures.permissions.map((item: string) => <li>{item}</li>)
                ) : (
                  <li>No non-standard sensitive device runtime permissions are required for core execution.</li>
                )}
              </ul>
            </div>

            <div class="policy-block">
              <h2>7. Security Safeguards and Practices</h2>
              <p>
                {disclosures.securityPractices ||
                  'All processed documents, files, and user inputs remain segregated within your mobile operating system application sandbox.'}
              </p>
            </div>

            <div class="policy-block">
              <h2>8. User Rights and Data Deletion</h2>
              <p>
                {disclosures.dataDeletion ||
                  'Because ModelPath Studio does not transmit or store your files on external servers, you retain complete authority over your data. Uninstalling the application or clearing local application storage immediately purges all application data.'}
              </p>
            </div>
          </div>
        )}

        <!-- Policy Footer Well -->
        <footer class="policy-footer-well">
          <div class="footer-well-content">
            <h3 class="footer-well-title">Data Protection &amp; Privacy Contact</h3>
            <p class="footer-well-text">
              Direct inquiries, deletion verifications, or technical questions concerning this privacy disclosure to our engineering team:
            </p>
            <a href={`mailto:${disclosures.contactEmail || privacyEmail}`} class="footer-email-link">
              {disclosures.contactEmail || privacyEmail}
            </a>
          </div>

          <div class="footer-nav-links">
            <a href={`/apps/${app.data.slug}/`} class="nav-chip-btn">
              <span>Back to {app.data.name}</span>
            </a>
            <a href={`/apps/${app.data.slug}/support/`} class="nav-chip-btn">
              <span>Product Support</span>
            </a>
            <a href="/privacy/" class="website-policy-link">
              Studio Website Privacy Policy &rarr;
            </a>
          </div>
        </footer>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .app-privacy-page {
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .policy-body-container {
    max-width: 920px;
  }

  /* App Privacy Hero (Dark Atmospheric) */
  .app-privacy-hero {
    padding-top: 56px;
    padding-bottom: 64px;
    background: radial-gradient(circle at 65% 25%, rgba(79, 107, 255, 0.18) 0%, rgba(139, 92, 246, 0.09) 45%, transparent 72%), var(--c-midnight, #0B1225);
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
  }

  .breadcrumb-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--c-text-light-muted, #94A3B8);
    margin-bottom: 24px;
  }

  .breadcrumb-bar a {
    color: var(--c-text-light-muted, #94A3B8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-bar a:hover {
    color: #FFFFFF;
  }

  .breadcrumb-bar span.current {
    color: var(--c-cyan, #73DDE6);
    font-weight: 600;
  }

  .header-main-row {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .app-icon-frame {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: linear-gradient(135deg, #172441, #0B1225);
    border: 2px solid rgba(79, 107, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-cobalt, #4F6BFF);
    flex-shrink: 0;
  }

  .app-icon-frame svg {
    width: 34px;
    height: 34px;
  }

  .header-titles {
    flex: 1;
  }

  .header-status-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .app-cat-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cyan, #73DDE6);
  }

  .status-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill, 9999px);
  }

  .status-pill.pill-verified {
    background: rgba(16, 185, 129, 0.15);
    color: #34D399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .status-pill.pill-pending-review,
  .status-pill.pill-draft {
    background: rgba(245, 158, 11, 0.15);
    color: #FBBF24;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .policy-main-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.025em;
    margin: 0 0 6px 0;
    line-height: 1.15;
  }

  .policy-meta-line {
    font-size: 0.88rem;
    color: var(--c-text-light-muted, #94A3B8);
    margin: 0;
  }

  /* Editorial Canvas */
  .editorial-canvas {
    background: var(--c-offwhite, #F8FAFC);
    color: var(--c-text-dark, #0F172A);
    padding: 64px 0 88px;
  }

  /* Unverified State Elements */
  .unverified-state-wrapper {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .unverified-banner-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 36px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    align-items: flex-start;
    gap: 24px;
    border-left: 5px solid #F59E0B;
  }

  .banner-icon-well {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(245, 158, 11, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D97706;
    flex-shrink: 0;
  }

  .banner-icon-well svg {
    width: 24px;
    height: 24px;
  }

  .banner-body {
    flex: 1;
  }

  .banner-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D97706;
    display: block;
    margin-bottom: 4px;
  }

  .banner-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 10px 0;
  }

  .banner-desc {
    font-size: 0.98rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.6;
    margin: 0 0 18px 0;
  }

  .readiness-lock-well {
    background: #FFFBEB;
    border-radius: 10px;
    padding: 16px 20px;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .lock-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #92400E;
    display: block;
    margin-bottom: 4px;
  }

  .lock-text {
    font-size: 0.88rem;
    color: #B45309;
    line-height: 1.55;
    margin: 0;
  }

  /* Technical Evidence Checklist */
  .evidence-checklist-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 36px;
    border: 1px solid rgba(203, 213, 225, 0.6);
  }

  .card-header {
    margin-bottom: 24px;
  }

  .card-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 4px;
  }

  .card-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 6px 0;
  }

  .card-subtext {
    font-size: 0.95rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.55;
    margin: 0;
  }

  .checklist-items {
    display: flex;
    flex-direction: column;
  }

  .checklist-row {
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    border-bottom: 1px solid rgba(203, 213, 225, 0.5);
  }

  .checklist-row:last-child {
    border-bottom: none;
    padding-bottom: 4px;
  }

  .checklist-main {
    flex: 1;
  }

  .checklist-category {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-cobalt, #4F6BFF);
    display: block;
    margin-bottom: 2px;
  }

  .checklist-name {
    font-family: var(--font-display, inherit);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 4px 0;
  }

  .checklist-detail {
    font-size: 0.9rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.5;
    margin: 0;
  }

  .checklist-badge-col {
    flex-shrink: 0;
  }

  .status-chip {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: var(--radius-pill, 9999px);
    white-space: nowrap;
  }

  .status-chip.chip-confirmed {
    background: rgba(16, 185, 129, 0.1);
    color: #047857;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .status-chip.chip-planned {
    background: rgba(79, 107, 255, 0.1);
    color: var(--c-cobalt, #4F6BFF);
    border: 1px solid rgba(79, 107, 255, 0.25);
  }

  .status-chip.chip-unconfirmed {
    background: rgba(245, 158, 11, 0.1);
    color: #B45309;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .evidence-footnote {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(203, 213, 225, 0.5);
  }

  .evidence-footnote p {
    font-size: 0.82rem;
    color: var(--c-text-dark-muted, #64748B);
    line-height: 1.55;
    margin: 0;
  }

  /* Verified Document Card */
  .verified-document-card {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 44px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .policy-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(203, 213, 225, 0.5);
  }

  .policy-block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .policy-block h2 {
    font-family: var(--font-display, inherit);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--c-text-dark, #0F172A);
    margin: 0;
  }

  .policy-block p {
    font-size: 0.98rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.65;
    margin: 0;
  }

  .policy-block ul {
    margin: 0;
    padding-left: 20px;
    color: var(--c-text-dark-muted, #475569);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  /* Policy Footer Well */
  .policy-footer-well {
    background: #FFFFFF;
    border-radius: var(--radius-card, 16px);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    padding: 28px 32px;
    margin-top: 36px;
    border: 1px solid rgba(203, 213, 225, 0.6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer-well-content {
    max-width: 520px;
  }

  .footer-well-title {
    font-family: var(--font-display, inherit);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--c-text-dark, #0F172A);
    margin: 0 0 6px 0;
  }

  .footer-well-text {
    font-size: 0.92rem;
    color: var(--c-text-dark-muted, #475569);
    line-height: 1.5;
    margin: 0 0 10px 0;
  }

  .footer-email-link {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-cobalt, #4F6BFF);
    text-decoration: underline;
  }

  .footer-nav-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .nav-chip-btn {
    background: var(--c-cobalt, #4F6BFF);
    color: #FFFFFF;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-pill, 9999px);
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(79, 107, 255, 0.25);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .nav-chip-btn:hover {
    background: var(--c-cobalt-hover, #3D58E6);
    transform: translateY(-1px);
  }

  .website-policy-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-text-dark-muted, #64748B);
    text-decoration: none;
