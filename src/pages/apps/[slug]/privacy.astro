---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.data.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const isVerified = app.data.privacyPolicyStatus === 'verified';
---

<BaseLayout 
  title={`${app.data.name} Privacy Policy`} 
  description={`Privacy Policy information for ${app.data.name}.`}
>
  <article>
    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.875rem; color: var(--color-text-muted);"><a href={`/apps/${app.data.slug}/`}>&larr; {app.data.name}</a></p>
      <h1 style="font-size: 2.25rem; margin: 0.5rem 0;">Privacy Policy — {app.data.name}</h1>
      <p style="font-size: 0.875rem; color: var(--color-text-muted);">
        Policy Status: <strong style="text-transform: uppercase; color: var(--color-text-primary);">{app.data.privacyPolicyStatus}</strong>
        {isVerified ? (
          <span> | Effective: {app.data.privacyPolicyEffectiveDate} | Last Updated: {app.data.privacyPolicyLastUpdated}</span>
        ) : (
          <span> | (Not Finalized — Pre-Release)</span>
        )}
      </p>
    </header>

    {!isVerified ? (
      <div style="padding: 1.5rem; background: var(--color-bg-inset); border-left: 4px solid var(--color-status-dev); margin-bottom: 2rem; border-radius: var(--radius-sm);">
        <h2 style="font-size: 1.125rem; margin-bottom: 0.5rem; color: var(--color-text-primary);">
          [UNPUBLISHED DRAFT] — Legal Verification In Progress
        </h2>
        <p style="color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 0.75rem;">
          This application is currently in development or pre-release preparation. A finalized, legally binding privacy policy has not yet been audited or published for <strong>{app.data.name}</strong>.
        </p>
        <p style="color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.6;">
          Complete and verified privacy disclosures regarding data retention, advertising SDKs, third-party libraries, and user permissions will be formally audited and published prior to any public store distribution.
        </p>
      </div>
    ) : (
      <div>
        <section style="margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Data Collection &amp; Usage</h2>
          <ul style="margin-left: 1.5rem; color: var(--color-text-secondary); line-height: 1.7;">
            {app.data.privacyDisclosures?.dataCollected.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section style="margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Third-Party Services &amp; Disclosures</h2>
          <ul style="margin-left: 1.5rem; color: var(--color-text-secondary); line-height: 1.7;">
            {app.data.privacyDisclosures?.thirdPartyServices.map((service) => (
              <li>{service}</li>
            ))}
          </ul>
        </section>

        <section style="margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Data Retention &amp; Storage</h2>
          <p style="color: var(--color-text-secondary);">
            {app.data.privacyDisclosures?.dataRetentionInfo}
          </p>
        </section>
      </div>
    )}

    <section style="margin-top: 2rem; margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Inquiries</h2>
      <p style="color: var(--color-text-secondary);">
        Direct questions regarding privacy or data handling for {app.data.name} to: 
        <a href={`mailto:${app.data.supportEmail}`}>{app.data.supportEmail}</a>
      </p>
    </section>

    <footer style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-subtle);">
      <a href={`/apps/${app.data.slug}/`}>&larr; Return to {app.data.name} overview</a>
    </footer>
  </article>
</BaseLayout>
