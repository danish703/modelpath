---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppGrid from '../../components/AppGrid.astro';
import { getCollection } from 'astro:content';
import { toCardModel } from '../../lib/appMedia';

const rawApps = await getCollection('apps');
const apps = rawApps
  .map((entry) => toCardModel(entry.data))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Applications Directory"
  description="Explore software developed by ModelPath Studio. Each product is engineered with a strict focus on utility, performance, and respectful on-device privacy."
>
  <div class="directory-container">
    <!-- Directory Header -->
    <header class="directory-header" data-reveal>
      <div class="breadcrumb">ModelPath Studio / Directory</div>
      <h1 class="directory-title">Our Applications</h1>
      <p class="directory-desc">
        Explore software developed by ModelPath Studio. Each product is engineered with a strict focus on utility, performance, and respectful on-device privacy.
      </p>

      <!-- Category Filter Pills -->
      <nav class="filter-nav" aria-label="Category Filters">
        <ul class="filter-tabs">
          <li>
            <button
              type="button"
              class="filter-pill active"
              data-category-filter="all"
              aria-pressed="true"
            >
              <span>All</span>
              <span class="filter-count">4</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              class="filter-pill"
              data-category-filter="productivity"
              aria-pressed="false"
            >
              <span>Productivity</span>
              <span class="filter-count">1</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              class="filter-pill"
              data-category-filter="reading"
              aria-pressed="false"
            >
              <span>Reading</span>
              <span class="filter-count">1</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              class="filter-pill"
              data-category-filter="education"
              aria-pressed="false"
            >
              <span>Education</span>
              <span class="filter-count">1</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              class="filter-pill"
              data-category-filter="machine learning"
              aria-pressed="false"
            >
              <span>Machine Learning</span>
              <span class="filter-count">1</span>
            </button>
          </li>
        </ul>
        <div id="filter-status" class="sr-only" aria-live="polite">Showing all 4 applications.</div>
      </nav>
    </header>

    <!-- Applications Grid -->
    <section class="apps-section" aria-label="Applications List">
      <AppGrid apps={apps} />
    </section>
  </div>
</BaseLayout>

<script>
  function setupCategoryFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const appCards = document.querySelectorAll<HTMLElement>('[data-app-card]');
    const statusRegion = document.getElementById('filter-status');

    if (!filterButtons.length || !appCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCategory = btn.getAttribute('data-category-filter') || 'all';

        // Update button states
        filterButtons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-pressed', String(isActive));
        });

        // Filter cards
        let visibleCount = 0;
        appCards.forEach((card) => {
          const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
          const shouldShow = selectedCategory === 'all' || cardCategory === selectedCategory;

          card.hidden = !shouldShow;
          if (shouldShow) visibleCount++;
        });

        if (statusRegion) {
          statusRegion.textContent = `Showing ${visibleCount} application${visibleCount === 1 ? '' : 's'} for ${btn.querySelector('span')?.textContent || selectedCategory}.`;
        }
      });
    });
  }

  setupCategoryFilters();
  document.addEventListener('astro:after-swap', setupCategoryFilters);
</script>

<style>
  .directory-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .directory-header {
    margin-bottom: 40px;
  }

  .breadcrumb {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }

  .directory-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-heading);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .directory-desc {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-body);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .filter-tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .filter-pill {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-body);
    background: var(--bg-surface);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-btn-secondary);
    border: 1px solid rgba(255, 255, 255, 0.85);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    color: var(--text-heading);
    transform: translateY(-1px);
  }

  .filter-pill.active {
    color: var(--accent-blue);
    box-shadow: var(--shadow-inset-box);
    background: var(--bg-inset);
  }

  .filter-count {
    font-size: 0.725rem;
    padding: 2px 7px;
    border-radius: 10px;
    background: var(--bg-inset);
    color: var(--text-muted);
    font-weight: 600;
  }

  .filter-pill.active .filter-count {
    background: var(--accent-blue);
    color: #FFFFFF;
  }

  .apps-section {
    margin-bottom: 64px;
  }

  @media (max-width: 600px) {
    .directory-header {
      margin-bottom: 28px;
    }

    .breadcrumb {
      font-size: 0.75rem;
      margin-bottom: 8px;
    }

    .directory-desc {
      font-size: 0.925rem;
      margin-bottom: 20px;
    }

    .filter-pill {
      font-size: 0.775rem;
      padding: 6px 12px;
      gap: 6px;
    }

    .filter-count {
      font-size: 0.6875rem;
      padding: 1px 6px;
    }

    .apps-section {
      margin-bottom: 40px;
    }
  }
</style>
