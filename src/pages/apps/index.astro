---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppGrid from '../../components/AppGrid.astro';
import { getCollection } from 'astro:content';
import { toCardModel } from '../../lib/appMedia';

const rawApps = await getCollection('apps');
const apps = rawApps
  .map((entry) => toCardModel(entry.data))
  .sort((a, b) => a.order - b.order);

// Category counts
const countAll = apps.length;
const countProd = apps.filter((a) => a.category.toLowerCase() === 'productivity').length;
const countReading = apps.filter((a) => a.category.toLowerCase() === 'reading').length;
const countEdu = apps.filter((a) => a.category.toLowerCase() === 'education').length;
const countMl = apps.filter((a) => a.category.toLowerCase() === 'machine learning').length;
---

<BaseLayout
  title="Applications Directory"
  description="Explore software developed by ModelPath Studio. Each product is engineered with a strict focus on utility, performance, and respectful on-device privacy."
>
  <div class="directory-page">
    <!-- Atmospheric Dark Hero Banner -->
    <header class="directory-hero">
      <div class="container" data-reveal>
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Home</a> &gt;
          <span class="current">Applications</span>
        </nav>

        <h1 class="directory-title">Our Applications</h1>
        <p class="directory-desc">
          Explore software developed by ModelPath Studio. Each product is engineered with a strict focus on utility, performance, and respectful on-device privacy.
        </p>

        <!-- Category Filter Pills -->
        <nav class="filter-nav" aria-label="Category Filters">
          <ul class="filter-tabs">
            <li>
              <button
                type="button"
                class="filter-pill active"
                data-category-filter="all"
                aria-pressed="true"
              >
                <span>All Applications</span>
                <span class="filter-count">{countAll}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="filter-pill"
                data-category-filter="productivity"
                aria-pressed="false"
              >
                <span>Productivity</span>
                <span class="filter-count">{countProd}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="filter-pill"
                data-category-filter="reading"
                aria-pressed="false"
              >
                <span>Reading</span>
                <span class="filter-count">{countReading}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="filter-pill"
                data-category-filter="education"
                aria-pressed="false"
              >
                <span>Education</span>
                <span class="filter-count">{countEdu}</span>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="filter-pill"
                data-category-filter="machine learning"
                aria-pressed="false"
              >
                <span>Machine Learning</span>
                <span class="filter-count">{countMl}</span>
              </button>
            </li>
          </ul>
          <div id="filter-status" class="sr-only" aria-live="polite">Showing all {countAll} applications.</div>
        </nav>
      </div>
    </header>

    <!-- Light Editorial Applications Grid -->
    <section class="directory-grid-section" aria-label="Applications List">
      <div class="container">
        <AppGrid apps={apps} />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupCategoryFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const appCards = document.querySelectorAll<HTMLElement>('[data-app-card]');
    const statusRegion = document.getElementById('filter-status');

    if (!filterButtons.length || !appCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.dataset.categoryFilter?.toLowerCase() || 'all';

        // Update active states
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        let visibleCount = 0;
        appCards.forEach((card) => {
          const cardCat = card.dataset.category?.toLowerCase() || '';
          if (selected === 'all' || cardCat === selected) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (statusRegion) {
          statusRegion.textContent = `Showing ${visibleCount} application${visibleCount === 1 ? '' : 's'}.`;
        }
      });
    });
  }

  setupCategoryFilters();
  document.addEventListener('astro:after-swap', setupCategoryFilters);
</script>

<style>
  .directory-page {
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Atmospheric Dark Hero Banner */
  .directory-hero {
    width: 100%;
    background: radial-gradient(circle at 50% 25%, rgba(79, 107, 255, 0.16) 0%, rgba(139, 92, 246, 0.08) 50%, transparent 75%), var(--c-midnight);
    border-bottom: 1px solid rgba(79, 107, 255, 0.18);
    padding-top: 140px;
    padding-bottom: 56px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--c-text-light-muted);
    margin-bottom: 20px;
  }

  .breadcrumb-nav a {
    color: var(--c-text-light-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-nav a:hover {
    color: #FFFFFF;
  }

  .breadcrumb-nav .current {
    color: var(--c-cyan);
    font-weight: 600;
  }

  .directory-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .directory-desc {
    font-size: 1.1rem;
    color: var(--c-text-light-muted);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 32px;
  }

  /* Filter Navigation */
  .filter-nav {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 6px 0 12px;
  }

  .filter-nav::-webkit-scrollbar {
    display: none;
  }

  .filter-tabs {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    margin: 0;
    padding: 0;
    list-style: none;
    width: max-content;
    min-width: 100%;
  }

  .filter-tabs li {
    flex-shrink: 0;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: rgba(23, 36, 65, 0.85);
    color: var(--c-text-light-muted);
    border: 1px solid rgba(79, 107, 255, 0.25);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    flex-shrink: 0;
    min-height: 44px;
    user-select: none;
  }

  .filter-pill:hover {
    color: #FFFFFF;
    border-color: var(--c-cobalt);
    background: rgba(30, 48, 86, 0.95);
  }

  .filter-pill.active {
    background: var(--c-cobalt);
    color: #FFFFFF;
    border-color: var(--c-cobalt);
    box-shadow: 0 4px 14px rgba(79, 107, 255, 0.35);
  }

  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: rgba(11, 18, 37, 0.4);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .filter-pill.active .filter-count {
    background: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  /* Editorial Grid Section */
  .directory-grid-section {
    width: 100%;
    background-color: var(--c-offwhite);
    padding: 80px 0;
    min-height: 480px;
  }

  @media (max-width: 860px) {
    .directory-hero {
      padding-top: 110px;
      padding-bottom: 44px;
    }
    .directory-grid-section {
      padding: 50px 0;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 16px;
    }
    .directory-hero {
      overflow-x: hidden;
    }
    .filter-tabs {
      gap: 8px;
    }
    .filter-pill {
      padding: 8px 14px;
      font-size: 0.84rem;
    }
  }
</style>
